            $("#btnAzaltmaPlaniSorumlusuDegistirKaydet").click(function () {

                $("#mdlTanimUyari").html("");
                //Validation
                var formKontrol = ValidateForm('needs-validation-azaltmaPlaniSorumlusuDegistir');
                if (!formKontrol) return;

