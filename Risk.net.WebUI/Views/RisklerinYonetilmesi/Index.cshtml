@{
    ViewData["Title"] = CustomResource["RiskAzaltmaPlani.SayfaBaslik"];
    ViewData["PageName"] = "RisklerinYonetilmesi";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-window mr-2'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["RiskAzaltmaPlani.SayfaAciklama"];
    ViewData["Category1"] = "";
    ViewData["Category1Url"] = "";
    ViewData["Yardim"] = ViewData["PageName"];

    #region DataTables yapılandırılması
    DataTablesYapi tablo = new DataTablesYapi();
    tablo.adi = "tblTanim";
    tablo.baslik = ViewData["Title"].ToString();
    tablo.listeUrl = "/RisklerinYonetilmesi/TabloDoldur";
    tablo.duzenleUrl = "/RisklerinYonetilmesi/KayitGetir";
    tablo.silUrl = "/RisklerinYonetilmesi/Sil";
    tablo.anahtarAlani = "Kod";
    tablo.anahtarAlani2 = "RiskYonetimi?.RiskAzaltmaPlani?.Kod";
    tablo.islemler.duzenlemeSonucMetodu = "Duzenle";
    tablo.islemler.genislik = "10%";
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.OnayaGonder"] + "' class='btn btn-success btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='OnayaGonder(!!DATA2!!)'><i class='fal fa-paper-plane'></i></a>";
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.TarihceGoster"] + "' class='btn btn-info btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='TarihceGoster(!!DATA2!!)'><i class='fal fa-history'></i></a>";
    tablo.islemler.silme = false;
    tablo.aramaAlaniGoster = true;
    tablo.siralamaKolonNo = 3;
    tablo.siralamaYonu = "desc";

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskAzaltmaPlaniSorumluKoordinatorluk.Adi",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.SorumluKoordinatorluk"],
                aramaTipi = "combo",
                aramaAlanAdi = "KoordinatorlukKod",
                aramaListeDoldurUrl = "/TanimKoordinatorluk/SelectListesiVer",
                aramaAlaniSecimTetikle = "BirimDoldur('ddlAramaBirimKod','ddlAramaKoordinatorlukKod', false)",
                render = "SorumluKoordinatorlukBirimRender(data,row.Koordinatorluk?.Adi)",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskAzaltmaPlaniSorumluBirim.Adi",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.SorumluBirim"],
                aramaTipi = "combo",
                aramaAlanAdi = "BirimKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaBirimKod', false, null, true)",
                render = "SorumluKoordinatorlukBirimRender(data,row.Birim?.Adi)",
                aramaAlaniSecimTetikle = "AmacDoldur('ddlAramaAmacKod','ddlAramaKoordinatorlukKod', false);",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Amac.Amac",
                adi = @CustomResource["RiskEvreni.Alan.Amac"],
                aramaTipi = "combo",
                aramaAlanAdi = "AmacKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaAmacKod', false, null, true)",
                aramaAlaniSecimTetikle = "HedefDoldur('ddlAramaHedefKod','ddlAramaAmacKod', false);",
                tablodaGoster = true,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Hedef.Adi",
                adi = @CustomResource["RiskEvreni.Alan.Hedef"],
                aramaTipi = "combo",
                aramaAlanAdi = "HedefKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaHedefKod', false, null, true)",
                tablodaGoster = true,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskNo",
                adi = @CustomResource["RiskEvreni.Alan.RiskNo"],
                render = "RiskNoRender(row.JenerikRisk,row.RiskYonetimi?.KontrolEdildi,data)",
                aramadaGoster = true,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskAdi",
                adi = @CustomResource["RiskEvreni.Alan.RiskAdi"],
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskTanimi",
                adi = @CustomResource["RiskEvreni.Alan.RiskTanimi"],
                aramadaGoster = false,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Adi",
                adi = @CustomResource["RiskYonetimi.Alan.RiskKategorisiAdi"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguRiskKategoriKod",
                aramaListeDoldurUrl = "/TanimRiskKategori/SelectListesiVer",
                siralama = false,
                tablodaGoster = false,
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskKategoriAdlari",
                adi = @CustomResource["RiskYonetimi.Alan.RiskKategorisiAdi"],
                aramadaGoster = false,
                siralama = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "AnahtarRiskGostergesiAdi",
                adi = @CustomResource["RiskEvreni.Alan.AnahtarRiskGostergesi"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "IlIrtibatOfisleriAdlari",
                adi = @CustomResource["RiskEvreni.Alan.IlIrtibatOfisi"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskSahibi.AdiSoyadi",
                adi = @CustomResource["RiskEvreni.Alan.RiskSahibi"],
                siralama = true,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.RiskAzaltmaPlani.AzaltmaPlaniSorumlusu.AdiSoyadi",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.Sorumlu"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguAzaltmaPlaniSorumlusuKod",
                aramaListeDoldurUrl = "/TanimPersonel/SelectListesiVer",
                siralama = true,
                aramadaGoster = ViewBag.RiskSahibiAra
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.ArtikRiskSeviyesi",
                adi = @CustomResource["RiskYonetimi.Alan.ArtikRiskSeviyesi"],
                render = "ArtikRiskSeviyesiAdiVer(data)",
                aramaTipi = "combo",
                aramaAlanAdi = "SorguArtikRiskSeviyesi",
                siralama = false,
                tablodaGoster = true,
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.RiskAzaltmaPlani.AzaltmaPlaniNo",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.AzaltmaPlaniNo"],
                aramaAlanAdi = "SorguAzaltmaPlaniNo",
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.RiskAzaltmaPlani.AzaltmaPlani",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.AzaltmaPlani"],
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.RiskAzaltmaPlani.BitisTarihi2",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.BitisTarihi"],
                tipi = "date",
                render = "TarihDegeriDDMMYYYY(data)",
                aramaTipi = "tarihAralik",
                aramaAlanAdi = "BitisTarihi",
                aramadaGoster = true,
                tablodaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.RiskAzaltmaPlani.MevcutDurum",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.MevcutDurum"],
                genislik = "9%",
                render = "MevcutDurumListesiAdiVer(data)",
                aramaTipi = "combo",
                aramaAlanAdi = "MevcutDurum",
                tablodaGoster = true,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskAzaltmaPlani",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.IsbirligiKoordinatorluk"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguIsbirligiKoordinatorlukKod",
                aramaListeDoldurUrl = "/TanimKoordinatorluk/SelectListesiVer",
                aramaAlaniSecimTetikle = "BirimDoldur('ddlAramaSorguIsbirligiBirimKod','ddlAramaSorguIsbirligiKoordinatorlukKod', false)",
                tablodaGoster = false,
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "",
                adi = @CustomResource["RiskAzaltmaPlani.Alan.IsbirligiBirim"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguIsbirligiBirimKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaSorguIsbirligiBirimKod', false, null, true)",
                tablodaGoster = false,
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "",
                adi = @CustomResource["RiskEvreni.Alan.KontrolEdildi"],
                aramaTipi = "combo",
                aramaAlanAdi = "KontrolEdildi",
                aramaListeDoldurUrl = "/RiskEvreni/KontrolEdildiSelectListesiVer",
                tablodaGoster = false,
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.RiskAzaltmaPlani.Durum",
                adi = @CustomResource["Genel.Alan.Durum"],
                tipi = "int",
                genislik = "10%",
                render = "DurumAdiVer(data)",
                aramaTipi = "combo",
                aramaAlanAdi = "Durum",
                aramadaGoster = true
            });


    var JSONTabloAyarlar = Newtonsoft.Json.JsonConvert.SerializeObject(tablo);
    #endregion

}

@section HeadBlock {
    <style type="text/css">
        .select2-container .select2-selection--multiple .select2-selection__choice {
            max-width: 100%;
            box-sizing: border-box;
            white-space: normal;
            word-wrap: break-word;
        }
    </style>
}

<div class="row">
    <div class="col-md-12">
        <div class="panel">
            @*<div class="panel-hdr">
            <h2></h2>
            <div class="panel-toolbar">
            <button id="btnYeniKayit" class="btn btn-success text-white"><i class="fal fa-plus mr-1"></i>@CustomResource["Dugme.YeniKayit"]</button>
            </div>
            </div>*@
            <!--Datatables alanı-->
            <div class="panel-container">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <vc:data-table tablo-ayar="@JSONTabloAyarlar"></vc:data-table>
                    </div>
                </div>
            </div>
            <!-- Datatables alanı -->
        </div>
    </div>
</div>
<!--Veri giriş Modal formu-->
<div id="mdlTanim" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"></h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true"><i class="fal fa-times text-white"></i></span>
                </button>
            </div>
            <div class="modal-body">

                <form class="needs-validation" novalidate>
                    <input type="hidden" id="hdnKod" />
                    <input type="hidden" id="hdnRiskYonetimiKod" />
                    <input type="hidden" id="hdnRiskEvreniKod" />
                    <input type="hidden" id="hdnKoordinatorlukKodBilgilendirme" />
                    <input type="hidden" id="hdnBirimKodBilgilendirme" />
                    <input type="hidden" id="hdnKoordinatorlukKod" />
                    <input type="hidden" id="hdnBirimKod" />
                    <input type="hidden" id="hdnSorumluKoordinatorlukKod" />
                    <input type="hidden" id="hdnSorumluBirimKod" />
                    <input type="hidden" id="hdnSorumluKod" />


                    <div id="mdlTanimUyari"></div>
                    <div class="form-group row">
                        <div class="col-md-2">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.RiskNo"]</label>
                            <div class="divRiskNo"></div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.RiskKategorisiAdi"]</label>
                            <div class="divRiskKategorisi"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.AzaltmaPlaniNo"]</label>
                            <div class="divAzaltmaPlaniNo"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.ArtikRiskSeviyesi"]</label>
                            <div class="divArtikRiskSeviyesi"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.ArtikRiskPuani"]</label>
                            <div class="divArtikRiskPuani"></div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label" for="txtRiskAdi">@CustomResource["RiskAzaltmaPlani.Alan.RiskAdi"]</label>
                            <select id="ddlRiskAdi" multiple></select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.RiskTanimi"]</label>
                            <div class="divRiskTanimi"></div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label" for="txtAzaltmaPlani">@CustomResource["RiskAzaltmaPlani.Alan.AzaltmaPlani"]<span class="text-danger ml-1">*</span></label>
                            <textarea id="txtAzaltmaPlani" rows="1" class="form-control form-control-sm" autocomplete="off" required></textarea>
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="form-label" for="txtBaslangicTarihi">@CustomResource["RiskAzaltmaPlani.Alan.BaslangicTarihi"]<span class="text-danger ml-1">*</span></label>
                            <input type="text" autocomplete="off" id="txtBaslangicTarihi" class="form-control form-control-sm tarihAlani" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="txtBitisTarihi">@CustomResource["RiskAzaltmaPlani.Alan.BitisTarihi"]<span class="text-danger ml-1">*</span></label>
                            <input type="text" autocomplete="off" id="txtBitisTarihi" class="form-control form-control-sm tarihAlani" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.AnahtarRiskGostergesiAdi"]</label>
                            <div class="divAnahtarRiskGostergesiAdi"></div>
                        </div>
                    </div>


                    <div class="form-group row">
                        @* <div class="col-md-6">
                        <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.Koordinatorluk"]<span class="text-danger ml-1">*</span></label>
                        <div class="divKoordinatorluk"></div>
                        </div>
                        <div class="col-md-6">
                        <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.SorumluBirim"]<span class="text-danger ml-1">*</span></label>
                        <div class="divSorumluBirim"></div>
                        </div>*@
                        <div class="col-md-6">
                            <label class="form-label" for="ddlKoordinatorluk">@CustomResource["RiskAzaltmaPlani.Alan.SorumluKoordinatorluk"]<span class="text-danger ml-1">*</span></label>
                            <select id="ddlKoordinatorluk" required></select>
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ddlBirim">@CustomResource["RiskAzaltmaPlani.Alan.SorumluBirim"]<span class="text-danger ml-1">*</span></label>
                            <select id="ddlSorumluBirim" required></select>
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.BirimlerIsbirligi"]</label>
                            <div class="p-3 rounded shadow-sm mb-g border border-faded isbirligiEkleSil">
                                <div class="input-group input-group-sm mb-2 dtabloVeriGiris">
                                    <div class="w-75 d-flex" style="white-space:nowrap;">
                                        <select id="ddlDinamikKoordinatorluk"></select>
                                        <select id="ddlDinamikBirim"></select>
                                    </div>
                                    <div class="input-group-append">
                                        <button class="btn btn-default" type="button" data-toggle="tooltip" title="@CustomResource["Dugme.Temizle"]" onclick="DTabloAlanTemizleIsbirligi();"><i class="fal fa-eraser"></i></button>
                                        <button class="btn btn-success" type="button" onclick="DinamikKoorBirimKaydet();">@CustomResource["Dugme.Ekle"]</button>
                                    </div>
                                </div>

                                <div id="divtblDinamikKoorBirimVeriYok"></div>
                                <table id="tblDinamikKoorBirim" class="table table-bordered table-hover table-striped table-sm w-100" style="display:none">
                                    <thead></thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.Sorumlu"]</label>
                            <div class="divSorumlu"></div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label" for="ddlIliskiliAzaltmaPlani">@CustomResource["RiskAzaltmaPlani.Alan.IlsikiliAzaltmaPlani"]</label>
                            <select id="ddlIliskiliAzaltmaPlani" multiple></select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-6">
                            <label class="form-label" for="ddlMevcutDurum">@CustomResource["RiskAzaltmaPlani.Alan.MevcutDurum"]<span class="text-danger ml-1">*</span></label>
                            <select id="ddlMevcutDurum" required></select>
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="txtTamamlanmaYuzdesi">@CustomResource["RiskAzaltmaPlani.Alan.TamamlanmaYuzdesi"]</label>
                            <input type="text" autocomplete="off" id="txtTamamlanmaYuzdesi" class="form-control form-control-sm" value="0" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.Donemler"]</label>
                            <div class="p-3 rounded shadow-sm mb-g border border-faded">
                                <div class="input-group input-group-sm mb-2 dtabloVeriGiris">
                                    <textarea id="txtDonemNotlari" rows="1" class="form-control form-control-sm" placeholder="@CustomResource["RiskAzaltmaPlani.Alan.DonemlerNotu"]"></textarea>
                                    <div class="input-group-append">
                                        <button class="btn btn-default waves-effect waves-themed" type="button" data-toggle="tooltip" title="@CustomResource["Dugme.Temizle"]" onclick="DTabloAlanTemizle();"><i class="fal fa-eraser"></i></button>
                                        <button class="btn btn-success" type="button" onclick="DonemNotlariKaydet();" id="btnDonemNotlariKaydet">@CustomResource["Dugme.Ekle"]</button>
                                    </div>
                                </div>

                                <div id="divtblDonemNotlariVeriYok"></div>
                                <table id="tblDonemNotlari" class="table table-bordered table-hover table-striped table-sm w-100" style="display:none">
                                    <thead></thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-6">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.ErtelenmisDegistirilmisZamanPlani"]</label>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <input type="text" autocomplete="off" id="txtErtelemeBaslangicTarihi" class="form-control form-control-sm tarihAlani" />
                                </div>
                                <div class="col-md-6">
                                    <input type="text" autocomplete="off" id="txtErtelemeBitisTarihi" class="form-control form-control-sm tarihAlani" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-6">
                            <label class="form-label" for="txtErtelemeNot">@CustomResource["RiskAzaltmaPlani.Alan.ErtelemeNot"]<span class="text-danger ml-1">*</span></label>
                            <textarea id="txtErtelemeNot" rows="1" class="form-control form-control-sm"></textarea>
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="txtAzaltmaPlaniNotlar">@CustomResource["RiskAzaltmaPlani.Alan.AzaltmaPlaniNotlar"]</label>
                            <textarea id="txtAzaltmaPlaniNotlar" rows="1" class="form-control form-control-sm"></textarea>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-12">
                            <div id="pnlAciklama" style="display:none;" class="form-group row">
                                <div class="col-md-12">
                                    <label class="form-label" for="txtTarihceAciklama"></label>
                                    <textarea id="txtTarihceAciklama" rows="1" class="form-control form-control-sm" disabled></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-row align-items-center flex-wrap flex-shrink-0">
                        <div id="pnlKontrolEdildi" class="ml-auto mb-4" style="display:none;">
                            <label class="form-label"></label>
                            <div class="custom-control custom-checkbox" style="float: right;">
                                <input type="checkbox" class="custom-control-input" id="chkKontrolEdildi" />
                                <label class="custom-control-label" style="width:90px;" for="chkKontrolEdildi">@CustomResource["RiskEvreni.Alan.KontrolEdildi"]</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-row align-items-center flex-wrap flex-shrink-0">
                        <div>
                            <button type="button" id="btnAzaltmaPlaniSorumlusuDegistir" class="btn btn-danger text-white mr-1" style="display:none;">@CustomResource["Dugme.AzaltmaPlaniSorumlusuDegistir"]</button>
                        </div>
                        <div class="ml-auto">
