        function BilgilendirmePenceresiAc() {
            ClearValidation('needs-validation-bilgilendirme');
            $('#ddlKoordinatorlukBilgilendirme').val($("#hdnKoordinatorlukKodBilgilendirme").val()).trigger('change');
            $('#ddlBirimBilgilendirme').val($("#hdnBirimKodBilgilendirme").val()).trigger('change');

            jModalShow("mdlBilgilendirme", "@CustomResource["Baslik.Bilgilendirme"]");
        }

        function OnayaGonder(kod, bildirim) {
            if (!(kod == null || kod == undefined)) {
                Swal.fire({
                    title: '@CustomResource["Baslik.OnayaGonder"]',
                    html: '@CustomResource["Onay.OnayaGonder"]',
                    showCancelButton: true,
                    confirmButtonText: '@CustomResource["Dugme.Evet"]',
                    cancelButtonText: '@CustomResource["Dugme.Hayır"]'
                }).then(function (result) {
                    if (result.value) {

                        $.ajax({
                            url: "/RisklerinYonetilmesi/OnayaGonder",
                            data: { kod: kod },
                            type: "POST",
                            success: function (result) {

                                if (result.IslemSonuc) {

                                    if (bildirim) {
                                        $('#hdnKoordinatorlukKodBilgilendirme').val($('#hdnKoordinatorlukKod').val());
                                        $('#hdnBirimKodBilgilendirme').val($('#hdnBirimKod').val());
                                    }

                                    ShowToastr("success", "toast-top-right", result.Mesaj);
                                    Temizle();
                                    TabloVeriYenile();
                                    jModalHide("mdlTanim");

                                    $("#hdnKod").val(kod);

                                    if (bildirim) {
                                        BilgilendirmePenceresiAc();
                                    }
                                    else {
                                        $.ajax({
                                            url: "/RisklerinYonetilmesi/KayitGetir",
                                            data: { riskAzaltmaPlaniKod: kod },
                                            type: "POST",
                                            success: function (result) {

                                                $("#hdnKoordinatorlukKodBilgilendirme").val(result?.Nesne?.KoordinatorlukKod);
                                                $("#hdnBirimKodBilgilendirme").val(result?.Nesne?.BirimKod);

                                                BilgilendirmePenceresiAc();
                                            }
                                        });
                                    }

                                }
                                else {
                                    HataPenceresiGoster(result.Mesaj);
                                }

                            }
                        });
                    }
                });
            }

        }

        function Duzenle(result) {
            Temizle(result.Nesne);
            jModalShow("mdlTanim", "@CustomResource["Baslik.Guncelle"]");
        }

        function Temizle(deger) {
            ClearValidation();

            $("#tblDinamikKoorBirim > tbody").empty();
            DinamikTabloVeriYok("tblDinamikKoorBirim")

            $("#tblDonemNotlari > tbody").empty();
            DinamikTabloVeriYok("tblDonemNotlari")
            DTabloAlanTemizle();

            $('#btnKaydet').text('@Html.Raw(@CustomResource["Dugme.AzaltmaPlaniOlustur"])');

            onayaGonder = false;
            $('#btnOnayaGonder').hide();

            if (deger?.RiskYonetimi?.RiskAzaltmaPlani?.Kod != undefined) {
                $('#btnKaydet').text('@Html.Raw(@CustomResource["Dugme.Guncelle"])');

                $('#btnOnayaGonder').show();
                if (deger?.RiskYonetimi?.RiskAzaltmaPlani?.Durum > 2) {
                    //if (deger?.RiskYonetimi?.RiskAzaltmaPlani?.Durum == 10)
                    //    $("#btnKaydet").hide();
                    //else
                    //    $("#btnKaydet").hide();
                    $("#btnOnayaGonder").hide();
                    onayaGonder = false;
                }
                else if (deger?.RiskYonetimi?.RiskAzaltmaPlani?.Durum > 0 && deger?.RiskYonetimi?.RiskAzaltmaPlani?.Durum < 3) {
                    $("#btnOnayaGonder").show();
                    //$("#btnKaydet").show();
                    onayaGonder = true;
                }
                else {
                    //$("#btnKaydet").show();
                    $("#btnOnayaGonder").hide();
                    onayaGonder = false;
                }
            }

            $.each(deger?.RiskYonetimi?.RiskAzaltmaPlani?.IsbirligiBirimler, function (a, b) {
                var koordinatorluk = b?.Koordinatorluk?.Adi;
                var birim = b?.Birim?.Adi;
                var kod = b?.Koordinatorluk?.Kod + "_" + b.Birim?.Kod;
                DTabloSatirEkleIsbirligi(kod, koordinatorluk, birim);
            });

            var form = {
                KoordinatorlukKod: deger?.RiskAzaltmaPlaniSorumluKoordinatorluk?.Kod,
                BirimKod: deger?.RiskAzaltmaPlaniSorumluBirim?.Kod,
                Kod: deger?.Kod,
            };

            $.ajax({
                url: "/RiskKaydi/SelectListesiVerRiskAdi",
                data: { form: form },
                type: "POST",
                success: function (result) {
                    Select2Yap("ddlRiskAdi", true, result);

                    var risklerForm = [];
                    $.each(deger?.RiskYonetimi?.RiskAzaltmaPlani?.Riskler, function (a, b) { risklerForm.push(b?.RiskEvreniKod); });
                    if (risklerForm.length == 0) { risklerForm.push(deger?.Kod); }
                    $("#ddlRiskAdi").val(risklerForm).trigger('change');
                }
            });


            $.ajax({
