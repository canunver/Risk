        //    $("#pnlSorumlu").hide();
        //    $("#pnlSorumluDegistir").show();
        //    $("#chkSorumluBaskasi").prop("checked", false);
        //}

        function ArtikRiskSeviyesiAdiVer(data) {
            var ad = "";
            if (artikRiskSeviyesiListe != undefined && artikRiskSeviyesiListe != null) {
                $.each(artikRiskSeviyesiListe, function (a, b) {
                    if (b.id == data)
                        ad = "<div class='text-center' style='color:#ffffff;line-height: 2em;background-color: " + b.ekBilgi + " !important;'>" + b.text + "</div>";
                });
            }
            return ad;
        }

        //Dinamik tablo üstünde bulunan Ekle ve Güncelle düğmesine basıldığında
        function DinamikKoorBirimKaydet() {

            var koordinatorluk = $("#ddlDinamikKoordinatorluk option:selected").text();
            var birim = $("#ddlDinamikBirim option:selected").text();
            var kod = $("#ddlDinamikKoordinatorluk").val() + "_" + $("#ddlDinamikBirim").val();

            if (kod.indexOf("null") > -1) kod = kod.replaceAll("null", "");
            var sakliKod = kod;
            if (sakliKod == "-100_" || sakliKod == "-101_") {
                $("#ddlDinamikKoordinatorluk option").each(function () {
                    kod = $(this).val();
                    if (kod == "-100" || kod == "-101") return;

                    kod = $(this).val() + "_";
                    var adi = $(this).text();

                    if ((adi.indexOf(" İl ") > -1 && sakliKod == "-100_") || ((adi.indexOf(" İl ") == -1 && sakliKod == "-101_"))) {
                        if (adi.indexOf(" Genel ") == -1 && adi.indexOf(" Makamı") == -1 && adi.indexOf(" Evrak") == -1)
                            DTabloSatirEkleIsbirligi(kod, adi, "");
                    }
                });
                DTabloAlanTemizleIsbirligi();
            }
            else {
                DTabloSatirEkleIsbirligi(kod, koordinatorluk, birim);
                DTabloAlanTemizleIsbirligi();
            }
        }

        function DinamikKoorBirimSil(kontrol) {

            var kod = $(kontrol).closest('tr')[0].id;
            var kontrolId = kod;

            kod = kod.replace("sttb_", "");

            $("#" + kontrolId).remove();

        }


        //Dinamik tabloya satır eklemek için
        function DTabloSatirEkleIsbirligi(kod, kAdi, bAdi) {

            var satirBilgi = "<td width='80%'>" + kAdi + " - " + bAdi + "</td>";

            var duzenle = ""
            var sil = "DinamikKoorBirimSil";

            DinamikTabloSatirEkle("tblDinamikKoorBirim", kod, satirBilgi, duzenle, sil, "")
        }

        //Dinamik tablo alanlarını temizlemek için
        function DTabloAlanTemizleIsbirligi() {
            $("#ddlDinamikKoordinatorluk").val("").trigger('change');
            $("#ddlDinamikBirim").val("").trigger('change');
            Select2Yap("ddlDinamikBirim", true, "");
        }

        function MevcutDurumListesiAdiVer(data) {
            var ad = "";
            if (mevcutDurumListesi != undefined && mevcutDurumListesi != null) {
                $.each(mevcutDurumListesi, function (a, b) {
                    if (b.id == data)
                        ad = b.text;
                });
            }
            return ad;
        }






        function DonemNotlariKontroller() {
            //Kontrollerin tablodan alınması
            var kontroller = [];
            $.makeArray($('#tblDonemNotlari > tbody tr[id]').map(function () {
                if ($(this).find("td:eq(0)").html() != null) {
                    //sadece kayıt edilmemiş olanlar gönderilecek. Bu işlem Yeni süreç kaydında dolacaktır
                    var kod = this.id.replace("sttb_", "");
                    //if (kod.indexOf("dtabloYeni_") > -1) {
                    var aForm = {
                        Kod: $(this).find("td:eq(0) input").val(),
                        RiskAzaltmaPlaniKod: $("#hdnKod").val(),
                        Aciklama: $(this).find("td:eq(0) div").html(),
                        Tarih: $(this).find("td:eq(1) input").val(),
                        Durum: $(this).find("td:eq(2) input").val(),
                    };
                    kontroller.push(aForm);
                    //}
                }
            }));
            return kontroller;
        }

        //Dinamik tablodan sil düğmesine basıldığında
        function DonemNotlariSil(kontrol) {
            if (DTabloSadeceOkuma) return;

            var kod = $(kontrol).closest('tr')[0].id;
            var kontrolId = kod;

            $("#" + kontrolId).remove();
        }

        //Dinamik tablo üstünde bulunan Ekle ve Güncelle düğmesine basıldığında
        function DonemNotlariKaydet() {

            if (DTabloSadeceOkuma) return;

            var aciklama = $("#txtDonemNotlari").val();

            if ($.trim(aciklama) == "") return;

            var form = {
                Kod: '',
                Aciklama: aciklama,
                RiskAzaltmaPlaniKod: $("#hdnKod").val(),
                Tarih: new Date(),
                Durum: $("#ddlMevcutDurum").val(),
            };

            if (form.Kod == "") form.Kod = "dtabloYeni_" + jQuery.guid++;
            DTabloSatirEkle(form);
            DTabloAlanTemizle();

            $("#mdlTanimUyari").html("");
        }

        //Dinamik tabloya satır eklemek için
        function DTabloSatirEkle(form) {

            var satirBilgi = "<td width='65%'><input type='hidden' value='" + form.Kod + "'/><div>" + form.Aciklama + "</div></td>";
            satirBilgi += "<td width='15%' style='vertical-align: middle;'><input type='hidden' value='" + form.Tarih + "'/>" + TarihDegeriDDMMYYYY(form.Tarih) + "</td>";
            satirBilgi += "<td width='15%' style='vertical-align: middle;'><input type='hidden' value='" + form.Durum + "'/>" + MevcutDurumListesiAdiVer(form.Durum) + "</td>";

            var duzenle = ""
            var sil = "DonemNotlariSil";

            if (DTabloSadeceOkuma) {
                duzenle = "";
                sil = "";
                $(".dtabloVeriGiris").hide();
            }

            DinamikTabloSatirEkle("tblDonemNotlari", form.Kod, satirBilgi, duzenle, sil, "");

            $(".kontrolSlider").trigger('change');
        }

        //Dinamik tablo alanlarını temizlemek için
        function DTabloAlanTemizle() {
            $("#txtDonemNotlari").val("").trigger('change');
            $("#btnDonemNotlariKaydet").html("@CustomResource["Dugme.Ekle"]");
        }


        function SorumluKoordinatorlukBirimRender(sorumlu, risk) {
            if (sorumlu == null) return "<span style='color: #e51a1a;'>" + risk + "</span>";
            return sorumlu;
        }


    </script>
