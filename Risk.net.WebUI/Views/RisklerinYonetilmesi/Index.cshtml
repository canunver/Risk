            $("#ddlKoordinatorluk").val(deger?.RiskAzaltmaPlaniSorumluKoordinatorluk?.Kod).trigger('change');

            $(".divRiskNo").html(deger?.RiskNo);
            $(".divRiskKategorisi").html(deger?.RiskKategoriAdlari ?? '');
