            $("#hdnAzaltmaPlaniSorumlusuKoordinatorlukKod").val(deger?.RiskAzaltmaPlaniSorumluKoordinatorluk?.Kod);
            $("#hdnAzaltmaPlaniSorumlusuBirimKod").val(deger?.RiskAzaltmaPlaniSorumluBirim?.Kod);
            $("#hdnAzaltmaPlaniSorumlusuKod").val(deger?.RiskYonetimi?.RiskAzaltmaPlani?.AzaltmaPlaniSorumlusuKod != null ? deger?.RiskYonetimi?.RiskAzaltmaPlani?.AzaltmaPlaniSorumlusuKod : deger?.RiskSahibiKod);

            $("#mdlTanimUyari").html("");

            //SorumluGizle();
        }

        function IskiliAzaltmaPlaniTemplate2(item) {
            var donus = "";

            if (item.text != "" && item.ekBilgi != null) {
                var bilgi = JSON.parse(item.ekBilgi);
                donus += "<div style='font-weight:bold;'>" + (bilgi?.SorumluBirim?.Adi ?? '') + ' / ' + (bilgi?.SorumluBirim?.Koordinatorluk?.Adi ?? '') + "</div>";
                if (TarihDegeriDDMMYYYY(bilgi?.BaslangicTarihi) != '')
                    donus += "<div>" + (TarihDegeriDDMMYYYY(bilgi?.BaslangicTarihi) ?? '-') + ' / ' + (TarihDegeriDDMMYYYY(bilgi?.BitisTarihi) ?? '-') + "</div>";
                donus += "<div>" + item.text + "</div>";

            }
            return donus;
        }


