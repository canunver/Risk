                            //$("#hdnAzaltmaPlaniSorumlusuKoordinatorlukKod").val('');
                            //$("#hdnAzaltmaPlaniSorumlusuBirimKod").val('');
                            //$("#hdnAzaltmaPlaniSorumlusuKod").val('');

