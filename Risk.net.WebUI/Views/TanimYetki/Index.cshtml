@{
    ViewData["Title"] = CustomResource["TanimYetki.SayfaBaslik"];
    ViewData["PageName"] = "TanimYetki";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-window mr-2'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["TanimYetki.SayfaAciklama"];
    ViewData["Category1"] = CustomResource["TanimMenu.SayfaBaslik"];
    ViewData["Category1Url"] = "/TanimMenu";
    ViewData["Yardim"] = ViewData["PageName"];

    #region DataTables yapılandırılması
    DataTablesYapi tablo = new DataTablesYapi();
    tablo.adi = "tblTanim";
    tablo.baslik = ViewData["Title"].ToString();
    tablo.listeUrl = "/TanimYetki/TabloDoldur";
    tablo.anahtarAlani = "Kod";
    tablo.islemler.goster = false;

    tablo.alanlar.Add(new DataTablesAlanlar
    {
        veriAlani = "KullaniciKod",
        adi = @CustomResource["TanimYetki.Alan.KullaniciKod"],
    });
    tablo.alanlar.Add(new DataTablesAlanlar
    {
        veriAlani = "Personel.AdiSoyadi",
        adi = @CustomResource["TanimYetki.Alan.Personel"],
        aramadaGoster = false
    });
    tablo.alanlar.Add(new DataTablesAlanlar
    {
        veriAlani = "Personel.AdiSoyadi",
        adi = @CustomResource["TanimYetki.Alan.Personel"],
        aramaTipi = "combo",
        aramaAlanAdi = "PersonelKod",
        aramaListeDoldurUrl = "/TanimYetki/SelectListesiVer",
        aramaListeDoldurKosul = "{koordinatorlukKod:'', birimKod:''}",
        tablodaGoster = false

    });
    tablo.alanlar.Add(new DataTablesAlanlar
    {
        veriAlani = "Rol",
        adi = @CustomResource["TanimYetki.Alan.Rol"],
    });
    tablo.alanlar.Add(new DataTablesAlanlar
    {
        veriAlani = "Koordinatorluk.Adi",
        adi = @CustomResource["TanimYetki.Alan.Koordinatorluk"],
        aramaTipi = "combo",
        aramaAlanAdi = "KoordinatorlukKod",
        aramaListeDoldurUrl = "/TanimKoordinatorluk/SelectListesiVer",
        aramaAlaniSecimTetikle = "BirimDoldur('ddlAramaBirimKod','ddlAramaKoordinatorlukKod', false)",
    });
    tablo.alanlar.Add(new DataTablesAlanlar
    {
        veriAlani = "Birim.Adi",
        adi = @CustomResource["TanimYetki.Alan.Birim"],
        aramaTipi = "combo",
        aramaAlanAdi = "BirimKod",
        aramaListeDoldurMetodu = "Select2Yap('ddlAramaBirimKod', false, null, true)"
    }); ;

    var JSONTabloAyarlar = Newtonsoft.Json.JsonConvert.SerializeObject(tablo);
    #endregion
}

<div class="row">
    <div class="col-md-12">
        <div class="panel">
            <!--Datatables alanı-->
            <div class="panel-container">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <vc:data-table tablo-ayar="@JSONTabloAyarlar"></vc:data-table>
                    </div>
                </div>
            </div>
            <!-- Datatables alanı -->
        </div>
    </div>
</div>

@section ScriptsBlock{
    <script type="text/javascript">
        $(document).ready(function () {

        });

    </script>
}
