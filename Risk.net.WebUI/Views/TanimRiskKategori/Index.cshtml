@{
    ViewData["Title"] = CustomResource["TanimRiskKategori.SayfaBaslik"];
    ViewData["PageName"] = "TanimRiskKategori";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-window mr-2'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["TanimRiskKategori.SayfaAciklama"];
    ViewData["Category1"] = CustomResource["TanimMenu.SayfaBaslik"];
    ViewData["Category1Url"] = "/TanimMenu";
    ViewData["Yardim"] = ViewData["PageName"];

    #region DataTables yapılandırılması
    DataTablesYapi tablo = new DataTablesYapi();
    tablo.adi = "tblTanim";
    tablo.baslik = ViewData["Title"].ToString();
    tablo.listeUrl = "/TanimRiskKategori/TabloDoldur";
    tablo.silUrl = "/TanimRiskKategori/Sil";
    tablo.duzenleUrl = "/TanimRiskKategori/KayitGetir";
    tablo.anahtarAlani = "Kod";
    tablo.islemler.duzenlemeSonucMetodu = "Duzenle";
    tablo.islemler.genislik = "15%";

    if (!ViewBag.KayitYetki && !ViewBag.OnayYetki)
        tablo.islemler.goster = false;

    if (!ViewBag.KayitYetki)
        tablo.islemler.duzenleme = false;

    if (ViewBag.OnayYetki)
        tablo.islemler.digerIslemler = "<a title='" + CustomResource["Dugme.Onayla"] + "' class='btn btn-success btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='Onayla(!!DATA!!)'><i class='fal fa-check'></i></a>";

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Adi",
                adi = @CustomResource["Genel.Alan.Adi"],
                tipi = "string",
                otomatikGenislik = true,
                siralama = true,
                genislik = ""
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Durum",
                adi = @CustomResource["Genel.Alan.Durum"],
                tipi = "int",
                genislik = "10%",
                render = "DurumAdiVer(data,'AKTIFPASIFONAYLI')",
                aramaTipi = "combo",
                aramaListeDoldurMetodu = "DurumDoldur('ddlAramaDurum','AKTIFPASIFONAYLI',false)",
            });

    var JSONTabloAyarlar = Newtonsoft.Json.JsonConvert.SerializeObject(tablo);
    #endregion

}

@*https://www.youtube.com/watch?v=1y18VF4aMZU*@

<div class="row">
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-hdr">
                <h2></h2>
                <div class="panel-toolbar">
                    <button id="btnYeniKayit" style="display:none;" class="btn btn-success text-white"><i class="fal fa-plus mr-1"></i>@CustomResource["Dugme.YeniKayit"]</button>
                </div>
            </div>
            <!--Datatables alanı-->
            <div class="panel-container">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <vc:data-table tablo-ayar="@JSONTabloAyarlar"></vc:data-table>
                    </div>
                </div>
            </div>
            <!-- Datatables alanı -->
        </div>
    </div>
</div>
<!--Veri giriş Modal formu-->
<div id="mdlTanim" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"></h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true"><i class="fal fa-times text-white"></i></span>
                </button>
            </div>
            <div class="modal-body">
                <form class="needs-validation" novalidate>
                    <input type="hidden" id="hdnKod" />

                    <div id="mdlTanimUyari"></div>

                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">@CustomResource["Genel.Alan.Adi"]<span class="text-danger ml-1">*</span></label>
                        <div class="col-md-9">
                            <input type="text" autocomplete="off" id="txtAdi" class="form-control form-control-sm autofocus" required />
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-row align-items-center flex-wrap flex-shrink-0">
                        <span class="spanDurum">@CustomResource["Genel.Alan.Durum"]: <span class="badge badge-primary p-2 text-white spnDurumAciklama"></span></span>
                        <div class="ml-auto">
                            <button type="button" id="btnKaydet" class="btn btn-primary text-white mr-1">@CustomResource["Dugme.Kaydet"]</button>
                            <button type="button" class="btn btn-secondary close-button" data-dismiss="modal">@CustomResource["Dugme.Kapat"]</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {

        var kayitYetki = @(ViewBag.KayitYetki.ToString().ToLower());
        var onayYetki = @(ViewBag.OnayYetki.ToString().ToLower());

        if (kayitYetki) {

            $("#btnYeniKayit").show();
        }

        $("#btnKaydet").click(function () {

            //Validation
            var formKontrol = ValidateForm();
            if (!formKontrol) return;


            var form = {
                Kod: $("#hdnKod").val(),
                Adi: $("#txtAdi").val(),
            };

            $.ajax({
                url: "/TanimRiskKategori/Kaydet",
                data: JSON.stringify(form),
                contentType: "application/json; charset=utf-8",
                type: "POST",
                dataType: "json",
                success: function (result) {

                    if (result.IslemSonuc) {
                        ShowToastr("success", "toast-top-right", result.Mesaj);
                        Temizle();
                        TabloVeriYenile();//Datatables viewcontrolünde
                        jModalHide("mdlTanim");
                    }
                    else {

                        HataYazisiGoster("mdlTanimUyari", result.Mesaj);
                    }
                }
            });

        });

        $("#btnYeniKayit").click(function () {
            Temizle();

            jModalShow("mdlTanim", "@CustomResource["Baslik.YeniKayit"]");
        });
    });

    function Duzenle(result) {
        Temizle(result.Nesne);
        $('#btnKaydet').text('@Html.Raw(@CustomResource["Dugme.Guncelle"])');
        jModalShow("mdlTanim", "@CustomResource["Baslik.Guncelle"]");
    }

    function Temizle(deger) {
        ClearValidation();

        $('#btnKaydet').text('@Html.Raw(@CustomResource["Dugme.Kaydet"])');

        $("#hdnKod").val(deger?.Kod);
        $("#txtAdi").val(deger?.Adi);

        //if (deger?.Durum == 10) {
        //    $("#btnKaydet").hide();
        //}
        //else {
        //    $("#btnKaydet").show();
        //}

        $(".spnDurumAciklama").html(DurumAdiVer(deger?.Durum, 'AKTIFPASIFONAYLI'));

        $("#mdlTanimUyari").html("");

    }

    function Onayla(kod) {
        Swal.fire({
            title: '@CustomResource["Baslik.Onay"]',
            html: '@CustomResource["Onay.Onay"]',
            showCancelButton: true,
            confirmButtonText: '@CustomResource["Dugme.Evet"]',
            cancelButtonText: '@CustomResource["Dugme.Hayır"]'
        }).then(function (result) {
            if (result.value) {

                $.ajax({
                    url: "/TanimRiskKategori/Onayla",
                    data: { kod: kod },
                    type: "POST",
                    success: function (result) {

                        if (result.IslemSonuc) {

                            ShowToastr("success", "toast-top-right", result.Mesaj);

                            TabloVeriYenile();
                        }
                        else {

                            HataPenceresiGoster(result.Mesaj);

                        }
                    }
                });
            }
        });
    }
</script>
