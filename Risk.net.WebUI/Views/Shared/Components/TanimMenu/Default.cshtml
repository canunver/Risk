@model SmartNavigation

@foreach (var group in Model.Lists)
{
    @if (group.Items.Any())
    {
        var groups = group.Items.Select(x => x.Href.ToPage()).Where(x => !x.IsVoid()).ToList();

        group.Items.ForEach(item =>
        {
            var result = item.Items?.Select(x => x.Href.ToPage()).Where(x => !x.IsVoid()).ToList();
            if (result?.Any() == true)
            {
                groups = groups.Concat(result).ToList();
            }
        });

        <div class="col-xl-4">
            <div class="card border shadow-0 mb-g shadow-sm-hover">
                <div class="panel-hdr">
                    <h2>
                        <span class="text-danger" title="@CustomResource[group.Text]">
                            <i class="fal @group.Icon"></i>
                            <span class="nav-link-text">@CustomResource[group.Text]</span>
                            @if (group.Span.HasValue())
                            {
                                <span class="@group.Span.Class">@group.Span.Text.AsRaw()</span>
                            }
                        </span>
                    </h2>
                </div>
                <div class="panel-content">
                    <ul class="nav-menu">
                        @{
                            foreach (var item in group.Items)
                            {
                                var items = item.Items?.Select(x => x.Href.ToPage()).Where(x => !x.IsVoid()).ToList();
                                <li>
                                    <a class="text-primary" href="@item.Route" title="@CustomResource[item.Title]" data-filter-tags="@(CustomResource[group.Text]+" "+CustomResource[item.Title])">
                                        <span class="nav-link-text">@CustomResource[item.Text]</span>
                                        @if (item.Span.HasValue())
                                        {
                                            <span class="@item.Span.Class">@item.Span.Text.AsRaw()</span>
                                        }
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
}
<script>

    $(document).ready(function () {

        $.each($('a[data-filter-tags]'), function (index, item) {
            var str = $(item).attr('data-filter-tags').toLowerCase();

            $(item).attr('data-filter-tags', str);
        });
    });

</script>
