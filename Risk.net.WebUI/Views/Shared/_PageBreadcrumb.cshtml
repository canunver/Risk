<div class="d-flex">
    @if (!string.IsNullOrWhiteSpace(ViewBag.Title))
    {
<ol class="breadcrumb page-breadcrumb">
            <li class="breadcrumb-item"><a href="/"><h4><i class="fal fa-home"></i></h4></a></li>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Category1))
    {
<li class="breadcrumb-item"><a href="@ViewBag.Category1Url">@ViewBag.Category1</a></li>
}
    @if (!string.IsNullOrWhiteSpace(ViewBag.Category2))
    {
<li class="breadcrumb-item" href="@ViewBag.Category2Url">@ViewBag.Category2</li>
}
    <li class="breadcrumb-item active">@ViewBag.Title</li>
</ol>}


    @if (!string.IsNullOrWhiteSpace(ViewBag.Yardim))
    {
<span class="ml-auto" onClick='YardimGoster("@ViewBag.Yardim")'>
    <i class='fad fa-question-circle fa-2x text-primary cursor-pointer'></i>
</span>}
</div>