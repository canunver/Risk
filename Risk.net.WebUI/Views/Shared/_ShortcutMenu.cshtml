@if (Settings.Features.ShortcutMenu)
{
<nav class="shortcut-menu d-none d-sm-block">
    <div id="navShortcutMenu" >
        <input type="checkbox" class="menu-open" name="menu-open" id="menu_open" />
        <label for="menu_open" class="menu-open-button ">
            <span class="app-shortcut-icon d-block"></span>
        </label>
        <a href="#" class="menu-item btn" data-action="app-scrolltop" data-toggle="tooltip" data-placement="left" title="@CustomResource["drpdwn.scrollTop"]">
            <i class="fal fa-arrow-up"></i>
        </a>
        <a href="/account/logout" class="menu-item btn" data-toggle="tooltip" data-placement="left" title="@CustomResource["drpdwn.pagelogout"]">
            <i class="fal fa-sign-out"></i>
        </a>
        <a href="#" class="menu-item btn" data-action="app-fullscreen" data-toggle="tooltip" data-placement="left" title="@CustomResource["drpdwn.fullscreen"]">
            <i class="fal fa-expand"></i>
        </a>
    </div>
</nav>}