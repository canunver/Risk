@{
}
<a class="brand-logo" href="#">
    <img class="img-fluid" style="position:relative;top:-10px;width:32px" src="~/img/logo.png" alt="logo" />
    <h2 class="brand-text text-primary ml-2">Risk Uygulaması</h2>
</a>
<!-- /Brand logo-->
<!-- Left Text-->
<div class="d-none d-lg-flex col-lg-8 align-items-center p-5 bg-gray-100">
    <div class="w-100 d-lg-flex align-items-center justify-content-center px-5">
        <img class="img-fluid" src="~/img/account/forgot-password-v2.svg" alt="risk" />
    </div>
</div>
<!-- /Left Text-->
<div class="d-flex col-lg-4 align-items-center auth-bg px-2 p-lg-5">
    <div class="col-12 col-sm-8 col-md-6 col-lg-12 px-xl-2 mx-auto">

        <!-- Kurum logo-->
        <div class="d-lg-flex col-lg-12 align-items-center p-5">
            <div class="w-100 d-lg-flex align-items-center justify-content-center px-5">
                <img class="img-fluid" src="~/img/kurumlogo.png" alt="logo" />
            </div>
        </div>
        <!-- /Kurum logo-->

        <h2 class="card-title fw-bold mb-1">@CustomResource["ForgotPassword.Baslik"]</h2>
        <p class="card-text mb-2">@CustomResource["ForgotPassword.BaslikAciklama"]</p>
        <br />
        <br />

        <form method="post" action="">
            <div class="form-group text-left">
                <label class="form-label" for="txtEPosta">@CustomResource["ForgotPassword.EPosta"]</label>
                <input type="text" id="txtEPosta" class="form-control" autofocus placeholder="@CustomResource["ForgotPassword.EPosta.Aciklama"]" value="" />
                <span validation-for="txtEPosta" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary text-white w-100">@CustomResource["ForgotPassword.Gonder"]</button>
            </div>
        </form>

        <p class="text-center mt-2"><a href="/account/login"><i data-feather="chevron-left"></i>@CustomResource["Dugme.GirisSayfasinaDon"]</a></p>
    </div>
</div>

