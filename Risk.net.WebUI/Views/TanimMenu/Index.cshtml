@{
    ViewData["Title"] = CustomResource["TanimMenu.SayfaBaslik"];
    ViewData["PageName"] = "TanimMenu";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-puzzle-piece mr-2'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["TanimMenu.SayfaAciklama"];
    ViewData["Category1"] = "";
    ViewData["Category1Url"] = "";
}



<div class="row">
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-container show">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="input-group p-2 mb-0">
                                    <input type="text" id="js-filter-tanimlar" name="filter-tanimlar" class="form-control form-control-md shadow-inset-2 form-control-lg" placeholder="@CustomResource["AramaAlani.Aciklama"]" autofocus>
                                    <div class="input-group-append">
                                        <div class="input-group-text">
                                            <i class="fal fa-search fs-xl"></i>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                            </div>
                        </div>

                        <div class="row" id="js-tanimlar">
                            <vc:tanim-menu />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section ScriptsBlock {
    <script>
        $(document).ready(function () {
            //initialize filter
            initApp.listFilter($('#js-tanimlar'), $('#js-filter-tanimlar'));

            var enyuksek = 0;
            $.each($(".card"), function (key, element) {
                if (enyuksek < $(element).height())
                    enyuksek = $(element).height();
            });

            $(".card").height(enyuksek);

        });</script>
}
