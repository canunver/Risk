            };

            $.ajax({
                url: '/Home/RiskPaneli',
                data: { form: form },
                type: "POST",
                global: false,//Ajaxstop metoduna etki etmesin
                success: function (result) {

                    if (result.IslemSonuc) {
                        var toplam = 0;
                        var cokYuksek = 0;
                        var yuksek = 0;
                        var orta = 0;
                        var dusuk = 0;
                        var cokDusuk = 0;

                        var cokYuksekArtik = 0;
                        var yuksekArtik = 0;
                        var ortaArtik = 0;
                        var dusukArtik = 0;
                        var cokDusukArtik = 0;

                        $.each(result.Liste[0], function (a, b) {
                            if (b.Aciklama == "1") cokDusuk = b.Deger1;
                            if (b.Aciklama == "2") dusuk = b.Deger1;
                            if (b.Aciklama == "3") orta = b.Deger1;
                            if (b.Aciklama == "4") yuksek = b.Deger1;
                            if (b.Aciklama == "5") cokYuksek = b.Deger1;

                            toplam += b.Deger1;
                        });

                        $.each(result.Liste[1], function (a, b) {
                            if (b.Aciklama == "1") cokDusukArtik = b.Deger1;
                            if (b.Aciklama == "2") dusukArtik = b.Deger1;
                            if (b.Aciklama == "3") ortaArtik = b.Deger1;
                            if (b.Aciklama == "4") yuksekArtik = b.Deger1;
                            if (b.Aciklama == "5") cokYuksekArtik = b.Deger1;
                        });


                        var spanSablon = "<div style='line-height:28px;'><span class='fs-xxl text-white'>0</span></div>";

                        toplam = toplam > 0 ? "<div style='line-height:59px;'><a href='#' onclick='RiskPaneliGoster(0,0);'><span class='fs-xxl text-white'>" + toplam + "</span></a></div>" : spanSablon;

                        cokYuksek = cokYuksek > 0 ? "<div style='line-height:28px;'><a href='#' title='Yapısal Risk Seviyesi' onclick='RiskPaneliGoster(5,0);'><span class='fs-xxl text-white'>" + cokYuksek + "</span></a></div>" : spanSablon;
                        yuksek = yuksek > 0 ? "<div style='line-height:28px;'><a href='#' title='Yapısal Risk Seviyesi' onclick='RiskPaneliGoster(4,0);'><span class='fs-xxl text-white'>" + yuksek + "</span></a></div>" : spanSablon;
                        orta = orta > 0 ? "<div style='line-height:28px;'><a href='#' title='Yapısal Risk Seviyesi' onclick='RiskPaneliGoster(3,0);'><span class='fs-xxl text-white'>" + orta + "</span></a></div>" : spanSablon;
                        dusuk = dusuk > 0 ? "<div style='line-height:28px;'><a href='#' title='Yapısal Risk Seviyesi' onclick='RiskPaneliGoster(2,0);'><span class='fs-xxl text-white'>" + dusuk + "</span></a></div>" : spanSablon;
                        cokDusuk = cokDusuk > 0 ? "<div style='line-height:28px;'><a href='#' title='Yapısal Risk Seviyesi' onclick='RiskPaneliGoster(1,0);'><span class='fs-xxl text-white'>" + cokDusuk + "</span></a></div>" : spanSablon;

                        var cokYuksek2 = cokYuksekArtik > 0 ? "<div style='line-height:28px;'><a href='#' title='Artık Risk Seviyesi' onclick='RiskPaneliGoster(0,5);'><span class='fs-xxl text-white'>" + cokYuksekArtik + "</span></a></div>" : spanSablon;
