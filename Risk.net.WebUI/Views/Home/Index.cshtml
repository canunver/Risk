                                            <th class="divRPYuksekRiskSayisi2" style="background-color: #FD0003; padding: 20px 0 20px; "><span class="fs-xxl text-white">0</span></th>
                                            <th class="divRPOrtaRiskSayisi2" style="background-color: #FFC001; padding: 20px 0 20px "><span class="fs-xxl text-white">0</span></th>
                                            <th class="divRPDusukRiskSayisi2" style="background-color: #00b24e; padding: 20px 0 20px "><span class="fs-xxl text-white">0</span></th>
                                            <th class="divRPCokDusukRiskSayisi2" style="background-color: #93d14c; padding: 20px 0 20px "><span class="fs-xxl text-white">0</span></th>
                                        </tr>
                                        <tr>
                                            <th colspan="5" class="text-center align-middle text-bold text-white" style="background-color:#aaa8a8"><h6>Artık Risk Seviyesi</h6></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="text-center align-middle" style="background-color:#eee">
                                            <td>Risk Sayısı</td>
                                            <td>Çok Yüksek <br>Risk Sayısı</td>
                                            <td>Yüksek <br>Risk Sayısı</td>
                                            <td>Orta <br>Risk Sayısı</td>
                                            <td>Düşük <br>Risk Sayısı</td>
                                            <td>Çok Düşük <br>Risk Sayısı</td>
                                        </tr>
                                    </tbody>
                                </table>


