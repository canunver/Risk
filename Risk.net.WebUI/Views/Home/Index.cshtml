                            height: GrafikYukseklik("pnlKRITolerans"),
                            colors: riskRenk,
                            annotations: {
                                alwaysOutside: true,
                                textStyle: {
                                    color: '#000',
                                    auraColor: 'none'
                                }
                            },
                            vAxis: {
                              format: '',
                              viewWindow: {
                                min: [0],
                              }
                            },
                        };

                        var chart = new google.visualization.ColumnChart(document.getElementById('grfKRITolerans'));

                        function selectHandler() {
                            var selectedItem = chart.getSelection()[0];
                            if (selectedItem) {
                                var secilenKategori = data.getValue(selectedItem.row, 0);
                                var secilenDurum = "";
                                if (selectedItem.column == 1)
                                    secilenDurum = "SARI";
                                if (selectedItem.column == 3)
                                    secilenDurum = "YESIL";
                                if (selectedItem.column == 5)
                                    secilenDurum = "KIRMIZI";

                                KRIToleransPaneliGoster(secilenKategori, secilenDurum);
                            }
                        }

                        google.visualization.events.addListener(chart, 'select', selectHandler);

                        chart.draw(data, options);

                        YenilemeLoaderDurdur();
                    }
                },
                error: function (result) {
                    $("#grfKRITolerans").html(veriYok);
                }
            });

        }

        function KRIToleransPie() {

            var form = {
                sorguTarihi1: $("#txtRiskPanoBaslamaTarih").val(),
                sorguTarihi2: $("#txtRiskPanoBitisTarih").val(),
                KoordinatorlukKod: sKoordinatorlukKod,
                BirimKod: sBirimKod
            };

            $.ajax({
                url: '/Home/KRIToleransPie',
                data: { form: form },
                type: "POST",
                global: false,//Ajaxstop metoduna etki etmesin
                success: function (result) {

                    if (result.IslemSonuc) {

                        if (result.Liste.length == 0) {
                            $("#grfKRIToleransPie").html(veriYok);
                            return;
                        }

                        var data = new google.visualization.DataTable();

                        data.addColumn('string', 'Açıklama');
                        data.addColumn('number', 'Değer');

                        var degerler = [];
                        $.each(result.Liste, function (index, value) {
                            var row = result.Liste[index];
                            degerler.push([row.Aciklama, row.Deger1]);
                        });
                        data.addRows(degerler);

                        var riskRenk = [];
                        $.each(result.Liste, function (index, value) {
                            var row = result.Liste[index];
                            if(row.Aciklama == "Henüz değerlendirilmemiş" && !riskRenk.includes("#808080"))
                                riskRenk.push("#808080");//Henüz değerlendirilmemiş
                            else if(row.Aciklama == "Kırmızı" && !riskRenk.includes("#f44336"))
                                riskRenk.push("#f44336");//Kırmızı
                            else if(row.Aciklama == "Sarı" && !riskRenk.includes("#ffc241"))
                                riskRenk.push("#ffc241");//Sarı
                            else if (row.Aciklama == "Yeşil" && !riskRenk.includes("#70b063"))
                                riskRenk.push("#70b063");//Yeşil
                        });
                       

                        var options = {
                            legend: { position: 'bottom' },
                            chartArea: { width: '90%', height: '80%', right: 0 },
                            is3D: false,
                            colors: riskRenk,
                            height: GrafikYukseklik("pnlKRIToleransPie"),
                            pieHole: 0.4,
                        };

                        var chart = new google.visualization.PieChart(document.getElementById('grfKRIToleransPie'));
                        chart.draw(data, options);

                        YenilemeLoaderDurdur();
                    }
                },
                error: function (result) {
                    $("#grfKRIToleransPie").html(veriYok);
                }
            });

        }

        function KRIToleransPaneliGoster(secilenKategori, secilenDurum) {
            if (secilenKategori == undefined || secilenKategori == "") return;

            var tablo = $("#tblArgListesi tbody");
            tablo.empty();

            var form = {
                KoordinatorlukKod: sKoordinatorlukKod,
                BirimKod: sBirimKod,
                Durum: secilenDurum,
                Kategori: secilenKategori,
            };

            $.ajax({
                url: '/Home/KRIToleransPaneli',
                data: { form: form },
                type: "POST",
                global: false,//Ajaxstop metoduna etki etmesin
                success: function (result) {
                    $.each(result.Liste, function (a, b) {
                        var td = "<td>" + b.RiskKategorisiAdi + "</td>";
                        td += "<td>" + b.AnahtarRiskGostergesiAdi + "</td>";
                        td += "<td>" + DurumVer(b.AnahtarRiskGostergesiDurum) + "</td>";
                        td += "<td>" + TrendVer(b.AnahtarRiskGostergesiTrend) + "</td>";

                        var satir = "<tr>" + td + "</tr>";

                        tablo.append(satir);
                    });

                    jModalShow("mdlArgListe", "Anahtar Risk Göstergesi");
                }
            });


        }

     function TrendVer(data) {
        if (data == undefined) return;

        var renk = "#bbb";

        var trend = "";
        if (data == "AZALAN") trend = "fa-arrow-alt-down";
        if (data == "ARTAN") trend = "fa-arrow-alt-up";
        if (data == "SABİT") trend = "fa-arrow-alt-right";

        if (trend != "")
            return "<div class='text-center genelTooltip' data-toggle='tooltip' style='color:" + renk + "' title='" + data + "'><i class='fas " + trend + " fa-2x'></i></div> ";
        else
            return "";
    }

    function DurumVer(data) {

        var renk = "";
        if (data == "KIRMIZI") renk = "#dc3545";
        if (data == "SARI") renk = "#ffc107";
        if (data == "YEŞİL") renk = "#28a745";

        if (renk != "")
            return "<div class='text-center genelTooltip' data-toggle='tooltip' style='color:" + renk + "' title='" + data + "'><i class='fas fa-circle fa-2x'></i></div>";
        else
            return "";
    }


    </script>

}

