        function GrafikYukseklik(kontrol) {
            var classes = $("#" + kontrol).attr('class');
            if (classes.indexOf("panel-fullscreen") > -1) {
                var pnl = document.querySelector("#" + kontrol);
                return pnl.offsetHeight * 80 / 100;
            }
            else
                return 300;
        }

        function RiskPaneliGoster(seviye, artikRiskSeviyesi, baslik) {

            var tablo = $("#tblRiskListesi tbody");
            tablo.empty();

            baslik = baslik ?? "Risk Paneli";

            var form = {
                sorguTarihi1: $("#txtRiskPanoBaslamaTarih").val(),
                sorguTarihi2: $("#txtRiskPanoBitisTarih").val(),
                KoordinatorlukKod: sKoordinatorlukKod,
                BirimKod: sBirimKod,
                YapisalRiskSeviyesi: seviye,
                ArtikRiskSeviyesi: artikRiskSeviyesi,
            };

            $.ajax({
                url: '/Home/RiskYonetimPaneli',
                data: { form: form },
                type: "POST",
                global: false,//Ajaxstop metoduna etki etmesin
                success: function (result) {
                    $.each(result.Liste, function (a, b) {
                        var td = "<td>" + b.KoordinatorlukAdi + "</td>";
                        td += "<td>" + b.BirimAdi + "</td>";
                        td += "<td>" + b.RiskNo + "</td>";
                        td += "<td>" + b.RiskAdi + "</td>";

                        var satir = "<tr>" + td + "</tr>";

                        tablo.append(satir);
                    });

                    jModalShow("mdlRiskListe", baslik);
                }
            });


        }

