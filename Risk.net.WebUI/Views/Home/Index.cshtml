        function colorFromValue(value, border) {
            var alpha = (1 + Math.log(value)) / 5;
            var color = "purple";
            if (border) {
                alpha += 0.01;
            }
            return Chart.helpers.color(color)
                .alpha(alpha)
                .rgbString();
        }

