                'bg-info-600    bg-success-gradient',
                'bg-success-300 bg-info-gradient',
                'bg-success-500 bg-primary-gradient',
                'bg-success-600 bg-success-gradient',
                'bg-danger-300  bg-success-gradient',
                'bg-danger-500  bg-info-gradient',
                'bg-danger-600  bg-primary-gradient',
                'bg-warning-300 bg-primray-gradient',
                'bg-warning-500 bg-info-gradient',
                'bg-warning-600 bg-success-gradient',
