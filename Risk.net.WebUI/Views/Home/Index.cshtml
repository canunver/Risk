        function Surec() {

            var form = {
                sorguTarihi1: $("#txtRiskPanoBaslamaTarih").val(),
                sorguTarihi2: $("#txtRiskPanoBitisTarih").val(),
                KoordinatorlukKod: sKoordinatorlukKod,
                BirimKod: sBirimKod,
                Aciklama: "",
                Deger1: 0,
                Deger2: 0.0
            };

            $.ajax({
                url: '/Home/Surec',
                data: { form: form },
                type: "POST",
                global: false,//Ajaxstop metoduna etki etmesin
                success: function (result) {

                    if (result.IslemSonuc) {

                        if (result.Liste.length == 0) {
                            $("#grfSurec").html(veriYok);
                            return;
                        }

                        var degerler = [];
                        degerler.push(["Açıklama", "Grup", "Değer"]);
                        degerler.push(["Süreçler", "", "0"]);

                        $.each(result.Liste, function (index, value) {
                            var adi = result.Liste[index].Aciklama + " (Risk Sayısı: " + result.Liste[index].Deger1 + ")";
                            degerler.push([adi, "Süreçler", result.Liste[index].Deger1]);
                        });

                        var data = google.visualization.arrayToDataTable(degerler);

                        var chart = new google.visualization.TreeMap(document.getElementById('grfSurec'));

                        chart.draw(data, {
                            fontColor: "#fff",
                            headerHighlightColor: "#fff",
                            highlightOnMouseOver: false,
                            maxDepth: 0,
                            maxPostDepth: 0,
                            minHighlightColor: "#14914C",
                            midHighlightColor: "#9ebcda",
                            maxHighlightColor: "#DC572B",
                            minColor: "#1ABF64",
                            midColor: "#DDAD00",
                            maxColor: "#FF6633",
                            headerHeight: 0,
                            showScale: true,
                            height: GrafikYukseklik("pnlSurec"),
                            useWeightedAverageForAggregation: false,
                            showTooltips: true
                        });

                        YenilemeLoaderDurdur();
                    }
                },
                error: function (result) {
                    $("#grfSurec").html(veriYok);
                }

            });

        }

