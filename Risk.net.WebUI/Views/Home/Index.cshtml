                        var orta2 = ortaArtik > 0 ? "<div style='line-height:28px;'><a href='#' title='Artık Risk Seviyesi' onclick='RiskPaneliGoster(0,3);'><span class='fs-xxl text-white'>" + ortaArtik + "</span></a></div>" : spanSablon;
