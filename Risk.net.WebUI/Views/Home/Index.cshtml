@{
    ViewData["Title"] = CustomResource["YoneticiEkrani.SayfaBaslik"];
    ViewData["PageName"] = "";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-user-chart'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["YoneticiEkrani.SayfaAciklama"];
    ViewData["Category1"] = "";
    ViewData["Category1Url"] = "";
}

@section HeadBlock {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

    @*<link rel="stylesheet" media="screen, print" href="~/css/fa-solid.css">
        <link rel="stylesheet" media="screen, print" href="~/css/theme-demo.css">*@
}
<style>
    svg > g > g:last-child {
        pointer-events: none
    }


    #tblRiskPaneli table, #tblRiskPaneli th, #tblRiskPaneli td {
        border: 1px solid #bbb;
        border-collapse: collapse;
    }

</style>
<div id="divPanelAlani" class="card mb-g">

    <div class="card-body">

        <div class="panel p-3 bg-gray-200">
            <div class="form-group row">
                <div class="col-md-4">
                    <label class="form-label">@CustomResource["RiskEvreni.Alan.RiskBaslamaBitisTarihi"]</label>
                    <div class="input-group">
                        <input type="text" autocomplete="off" id="txtRiskPanoBaslamaTarih" class="form-control form-control-sm tarihAlani" />
                        <div class="input-group-append input-group-prepend">
                            <span class="input-group-text">
                                <i class="fal fa-minus"></i>
                            </span>
                        </div>
                        <input type="text" autocomplete="off" id="txtRiskPanoBitisTarih" class="form-control form-control-sm tarihAlani" />
                        <div class="input-group-append">
                            <button class="btn btn-xs btn-primary" type="button" onclick="GrafikleriYukle()">Yenile</button>
                        </div>
                    </div>
                </div>


                <div class="col-md-4">
                    <label class="form-label" for="ddlKoordinatorluk">@CustomResource["RiskEvreni.Alan.Koordinatorluk"]</label>
                    <select id="ddlKoordinatorluk" required></select>
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="ddlBirim">@CustomResource["RiskEvreni.Alan.Birim"]</label>
                    <select id="ddlBirim" required></select>
                </div>
            </div>
        </div>

        <div class="row">


