                                        </tr>
                                        <tr class="text-center">
                                            <th class="divRPCokYuksekRiskSayisi1" style="background-color: #C00002; padding: 20px 0 20px; "><span class="fs-xxl text-white">0</span></th>
                                            <th class="divRPYuksekRiskSayisi1" style="background-color: #FD0003; padding: 20px 0 20px; "><span class="fs-xxl text-white">0</span></th>
                                            <th class="divRPOrtaRiskSayisi1" style="background-color: #FFC001; padding: 20px 0 20px "><span class="fs-xxl text-white">0</span></th>
                                            <th class="divRPDusukRiskSayisi1" style="background-color: #00b24e; padding: 20px 0 20px "><span class="fs-xxl text-white">0</span></th>
                                            <th class="divRPCokDusukRiskSayisi1" style="background-color: #93d14c; padding: 20px 0 20px "><span class="fs-xxl text-white">0</span></th>
