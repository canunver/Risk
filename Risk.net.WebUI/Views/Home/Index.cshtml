            "#8CC152", "#48CFAD", "#37BC9B", "#4FC1E9", "#ED5565",
            "#5D9CEC", "#FFA07A", "#E7858E", "#9B587E",
            "#D770AD", "#4A89DC", "#CCD1D9", "#D2B48C",
            "#A7DBD8", "#3FB8AF", "#F7BD80", "#AAB2BD",]

        $(document).ready(function () {

            sKoordinatorlukKod = "@ViewBag.KoordinatorlukKodu";
            sBirimKod = "@ViewBag.BirimKodu";
            var ilkBirimKod = sBirimKod;

            $.ajax({
                url: "/TanimKoordinatorluk/SelectListesiVer",
                type: "POST",
                success: function (result) {

                    Select2Yap("ddlKoordinatorluk", true, result);

                    $("#ddlKoordinatorluk").val("@ViewBag.KoordinatorlukKodu").trigger('change');
                }
            });

            $('#ddlKoordinatorluk').bind('change', function () {
                grafikleriYenile = false;
                sKoordinatorlukKod = $(this).val();
                if (sKoordinatorlukKod == null) sKoordinatorlukKod = "";

                $.ajax({
                    url: "/TanimBirim/SelectListesiVer",
                    data: { koordinatorlukKod: sKoordinatorlukKod, yetki: true },
                    type: "POST",
                    success: function (result) {

                        if (result.length > 0) {

                            Select2Yap("ddlBirim", true, result);

                            if (ilkBirimKod != "")
                                $("#ddlBirim").val(ilkBirimKod).trigger('change');
                            //else
                            //    $("#ddlBirim").val(sBirimKod).trigger('change');

                        }
                        else {
                            Select2Yap("ddlBirim", true, null);
                        }
                    }
                });

            });

            $('#ddlBirim').bind('change', function () {
                sBirimKod = $(this).val();
                if (sBirimKod == null) sBirimKod = "";

                GrafikleriYukle();
            });

            TarihAlanlariAyarla();

            google.charts.load('current', { 'packages': ['treemap', 'corechart', 'bar', 'scatter'] });

            $(document).ajaxStop(function () {
                grafikleriYenile = true;
                GrafikleriYukle();
            });
        });


        function GrafikleriYukle() {
            if (!grafikleriYenile) return;

            RiskPaneliYenile();
            PerformansIzlemePaneliYenile();

            //google.charts.setOnLoadCallback(EylemDurumu);
            google.charts.setOnLoadCallback(BulguDurumu);
            google.charts.setOnLoadCallback(BulguOnemDuzeyi);
            google.charts.setOnLoadCallback(Surec);
            google.charts.setOnLoadCallback(RiskKategorileri);
            google.charts.setOnLoadCallback(YapisalRiskSeviyesi);
            google.charts.setOnLoadCallback(ArtikRiskSeviyesi);
            //google.charts.setOnLoadCallback(RiskIzlemeMatrisi);
            google.charts.setOnLoadCallback(RiskPuani);
            google.charts.setOnLoadCallback(AnahtarRiskGostergesi);
            google.charts.setOnLoadCallback(RiskeVerilenYanit);
            google.charts.setOnLoadCallback(KRITolerans);
            google.charts.setOnLoadCallback(KRIToleransPie);
        }

        //Panel refresh yapıldığında bekleme gri ekranın grafik oluşturulduktan sonra yok edilmesi için
        function YenilemeLoaderDurdur() {
            if (aktifPanel)
                aktifPanel.removeClass('panel-refresh').children('.panel-container').removeClass('enable-loader').dequeue();
        }

        //Panel yenileme işlmenin işlem yapılan panel idsine göre çalıştırılması
        function PanelYenile(panel) {

            var id = panel.attr('id');

            if (id == "pnlBulguDurum") {
                google.charts.setOnLoadCallback(BulguDurumu);
            }
            //else if (id == "pnlEylemDurumu") {
            //    google.charts.setOnLoadCallback(EylemDurumu);
            //}
            else if (id == "pnlBulguOnemDuzeyi") {
                google.charts.setOnLoadCallback(BulguOnemDuzeyi);
            }
            else if (id == "pnlSurec") {
                google.charts.setOnLoadCallback(Surec);
            }
            else if (id == "pnlRiskKategori") {
                google.charts.setOnLoadCallback(RiskKategorileri);
            }
            else if (id == "pnlYapisalRiskSeviyesi") {
                google.charts.setOnLoadCallback(YapisalRiskSeviyesi);
            }
            else if (id == "pnlArtikRiskSeviyesi") {
                google.charts.setOnLoadCallback(ArtikRiskSeviyesi);
            }
            //else if (id == "pnlRiskIzlemeMatrisi") {
            //    google.charts.setOnLoadCallback(RiskIzlemeMatrisi);
            //}
            else if (id == "pnlRiskPanosu") {
                YenilemeLoaderDurdur();
                return false;
            }
            else if (id == "pnlRiskPuani") {
                google.charts.setOnLoadCallback(RiskPuani);
            }
            else if (id == "pnlAnahtarRiskGostergesi") {
                google.charts.setOnLoadCallback(AnahtarRiskGostergesi);
            }
            else if (id == "pnlRiskeVerilenYanit") {
                google.charts.setOnLoadCallback(RiskeVerilenYanit);
            }
            else if (id == "pnlPerformansIzleme") {
                PerformansIzlemePaneliYenile();
            }
            else if (id == "pnlKRITolerans") {
                google.charts.setOnLoadCallback(KRITolerans);
            }
            else if (id == "pnlKRIToleransPie") {
                google.charts.setOnLoadCallback(KRIToleransPie);
            }
        }

        function BulguDurumu() {

            var form = {
                sorguTarihi1: $("#txtRiskPanoBaslamaTarih").val(),
                sorguTarihi2: $("#txtRiskPanoBitisTarih").val(),
                KoordinatorlukKod: sKoordinatorlukKod,
                BirimKod: sBirimKod
            };

            $.ajax({
                url: '/Home/BulguDurumu',
                data: { form: form },
                type: "POST",
                global: false,//Ajaxstop metoduna etki etmesin
                success: function (result) {

                    if (result.IslemSonuc) {

                        if (result.Liste.length == 0) {
                            $("#grfBulguDurum").html(veriYok);
                            return;
                        }

                        var degerler = [];
                        degerler.push(["Açıklama", "Değer"]);

                        $.each(result.Liste, function (index, value) {
                            degerler.push([result.Liste[index].Aciklama, result.Liste[index].Deger1]);
                        });

                        var data = google.visualization.arrayToDataTable(degerler);

                        var options = {
                            legend: { position: 'bottom' },
                            chartArea: { width: '90%', height: '80%', right: 0 },
                            is3D: true,
                            colors: renkler,
                            height: GrafikYukseklik("pnlBulguDurum"),
                        };

                        var chart = new google.visualization.PieChart(document.getElementById('grfBulguDurum'));
                        chart.draw(data, options);

                        YenilemeLoaderDurdur();
                    }
                },
                error: function (result) {
                    $("#grfBulguDurum").html(veriYok);
                }
            });

        }

        function YapisalRiskSeviyesi() {

            var form = {
                sorguTarihi1: $("#txtRiskPanoBaslamaTarih").val(),
                sorguTarihi2: $("#txtRiskPanoBitisTarih").val(),
                KoordinatorlukKod: sKoordinatorlukKod,
                BirimKod: sBirimKod
            };

            $.ajax({
                url: '/Home/YapisalRiskSeviyesi',
                data: { form: form },
                type: "POST",
                global: false,//Ajaxstop metoduna etki etmesin
                success: function (result) {

                    if (result.IslemSonuc) {

                        if (result.Liste.length == 0) {
                            $("#grfYapisalRiskSeviyesi").html(veriYok);
                            return;
                        }

                        var degerler = [];
                        degerler.push(["Açıklama", "Değer"]);

                        var riskRenk = [];
                        $.each(result.Liste, function (index, value) {
                            var aciklama = result.Liste[index].Aciklama;
                            if (aciklama == "Çok Yüksek") riskRenk.push("#C00002");
                            else if (aciklama == "Yüksek") riskRenk.push("#FD0003");
                            else if (aciklama == "Orta") riskRenk.push("#FFC001");
                            else if (aciklama == "Düşük") riskRenk.push("#00B24E");
                            else if (aciklama == "Çok Düşük") riskRenk.push("#93D14C");

                            degerler.push([aciklama, result.Liste[index].Deger1]);
                        });

                        var data = google.visualization.arrayToDataTable(degerler);

                        var options = {
                            legend: { position: 'bottom' },
                            chartArea: { width: '90%', height: '80%', right: 0 },
                            is3D: true,
                            colors: riskRenk,
                            height: GrafikYukseklik("pnlYapisalRiskSeviyesi"),
                        };

                        var chart = new google.visualization.PieChart(document.getElementById('grfYapisalRiskSeviyesi'));

                        function selectHandler() {
                            var selectedItem = chart.getSelection()[0];
                            if (selectedItem) {
                                var secilen = data.getValue(selectedItem.row, 0);
                                YapisalRiskSeviyesiListeGoster(secilen);
                            }
                        }

                        google.visualization.events.addListener(chart, 'select', selectHandler);

                        chart.draw(data, options);

                        YenilemeLoaderDurdur();
                    }
                },
                error: function (result) {
                    $("#grfYapisalRiskSeviyesi").html(veriYok);
                }
            });

        }

