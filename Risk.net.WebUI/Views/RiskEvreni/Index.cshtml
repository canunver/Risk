@{
    ViewData["Title"] = CustomResource["RiskIzleme.SayfaBaslik"];
    ViewData["PageName"] = "RiskEvreni";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-window mr-2'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["RiskIzleme.SayfaAciklama"];
    ViewData["Category1"] = "";
    ViewData["Category1Url"] = "";
    ViewData["Yardim"] = ViewData["PageName"];

    #region DataTables yapılandırılması
    DataTablesYapi tablo = new DataTablesYapi();
    tablo.adi = "tblTanim";
    tablo.baslik = ViewData["Title"].ToString();
    tablo.listeUrl = "/RiskEvreni/TabloDoldur";
    tablo.duzenleUrl = "/RiskEvreni/KayitGetir";
    tablo.anahtarAlani = "Kod";
    tablo.islemler.duzenlemeSonucMetodu = "Duzenle";
    tablo.islemler.genislik = "5%";
    tablo.islemler.silme = false;
    tablo.islemler.duzenleme = false;
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.RiskIzleme"] + "' class='btn btn-success btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='TabloVeriDuzenle(!!DATA!!)'><i class='fal fa-eye'></i></a>";
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.TarihceGoster"] + "' class='btn btn-info btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='TarihceGosterIc(!!DATA!!)'><i class='fal fa-history'></i></a>";
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.Kopyala"] + "' class='btn btn-secondary btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='Kopyala(!!DATA!!)'><i class='fal fa-copy'></i></a>";


    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Koordinatorluk.Adi",
                adi = @CustomResource["RiskEvreni.Alan.Koordinatorluk"],
                aramaTipi = "combo",
                aramaAlanAdi = "KoordinatorlukKod",
                //aramaListeDoldurUrl = "/TanimKoordinatorluk/SelectListesiVer",
                aramaListeDoldurMetodu = "KoordinatorlukDoldur('ddlAramaKoordinatorlukKod')",
                aramaAlaniSecimTetikle = "BirimDoldur('ddlAramaBirimKod','ddlAramaKoordinatorlukKod', false)",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Birim.Adi",
                adi = @CustomResource["RiskEvreni.Alan.Birim"],
                aramaTipi = "combo",
                aramaAlanAdi = "BirimKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaBirimKod', false, null, true)",
                aramaAlaniSecimTetikle = "SurecDoldur('ddlAramaSurecKod','ddlAramaKoordinatorlukKod','ddlAramaBirimKod', false);"
                + "AmacDoldur('ddlAramaAmacKod','ddlAramaKoordinatorlukKod', false);",
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Amac.StratejikPlanDonem.BaslamaYil",
                adi = @CustomResource["StratejikPlan.Alan.Donem"],
                aramaTipi = "combo",
                aramaAlanAdi = "Amac.StratejikPlanDonemKod",
                aramaListeDoldurUrl = "/TanimStratejikPlanDonem/SelectListesiVer",
                render = "row?.Amac?.StratejikPlanDonemAdi",
                aramadaGoster = false,
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Amac.Amac",
                adi = @CustomResource["RiskEvreni.Alan.Amac"],
                aramaTipi = "combo",
                aramaAlanAdi = "AmacKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaAmacKod', false, null, true)",
                aramaAlaniSecimTetikle = "HedefDoldur('ddlAramaHedefKod','ddlAramaAmacKod', false);",
                tablodaGoster = true,
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Hedef.Adi",
                adi = @CustomResource["RiskEvreni.Alan.Hedef"],
                aramaTipi = "combo",
                aramaAlanAdi = "HedefKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaHedefKod', false, null, true)",
                tablodaGoster = true,
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Surec.Adi",
                adi = @CustomResource["Surec.Alan.Adi"],
                aramaTipi = "combo",
                aramaAlanAdi = "SurecKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaSurecKod', false, null, true)"
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskNo",
                adi = @CustomResource["RiskEvreni.Alan.RiskNo"],
                render = "RiskNoRender(row.JenerikRisk,row.KontrolEdildi,data)",
                aramadaGoster = true,
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskAdi",
                adi = @CustomResource["RiskEvreni.Alan.RiskAdi"],
                aramadaGoster = false,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskTanimi",
                adi = @CustomResource["RiskEvreni.Alan.RiskTanimi"],
                aramadaGoster = true,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskKategoriAdlari",
                adi = @CustomResource["RiskEvreni.Alan.RiskKategorisiAdi"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "IlIrtibatOfisleriAdlari",
                adi = @CustomResource["RiskEvreni.Alan.IlIrtibatOfisi"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskSahibi.AdiSoyadi",
                adi = @CustomResource["RiskEvreni.Alan.RiskSahibi"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguRiskSahibiKod",
                aramaListeDoldurUrl = "/TanimPersonel/SelectListesiVer",
                siralama = true,
                aramadaGoster = ViewBag.RiskSahibiAra
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.RiskAzaltmaPlani.AzaltmaPlaniSorumlusu.AdiSoyadi",
                adi = @CustomResource["RiskEvreni.Alan.AzaltmaPlaniSorumlusu"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguAzaltmaPlaniSorumlusuKod",
                aramaListeDoldurUrl = "/TanimPersonel/SelectListesiVer",
                siralama = true,
                aramadaGoster = ViewBag.RiskSahibiAra
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Adi",
                adi = @CustomResource["RiskEvreni.Alan.RiskKategorileri"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguRiskKategoriKod",
                aramaListeDoldurUrl = "/TanimRiskKategori/SelectListesiVer",
                siralama = false,
                tablodaGoster = false,
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "SorguGecerlilikTarihi",
                adi = @CustomResource["RiskEvreni.Alan.RiskGecerlilikTarihi"],
                tipi = "date",
                render = "TarihDegeriDDMMYYYY(data)",
                aramaTipi = "tarihAralik",
                siralama = false,
                tablodaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskGecerlilikTarihi",
                adi = @CustomResource["RiskEvreni.Alan.RiskGecerlilikTarihi"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "",
                adi = @CustomResource["RiskEvreni.Alan.BaskasiAdinaRiskDurumu"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguBaskasiAdinaRiskDurumu",
                aramaListeDoldurUrl = "/RiskEvreni/BaskasiAdinaRiskSelectListesiVer",
                tablodaGoster = false,
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "",
                adi = @CustomResource["RiskEvreni.Alan.KontrolEdildi"],
                aramaTipi = "combo",
                aramaAlanAdi = "KontrolEdildi",
                aramaListeDoldurUrl = "/RiskEvreni/KontrolEdildiSelectListesiVer",
                tablodaGoster = false,
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Durum",
                adi = @CustomResource["Genel.Alan.Durum"],
                tipi = "int",
                genislik = "10%",
                render = "DurumAdiVer(data,1)",
                aramaTipi = "combo",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaDurum', true, null)",
            });

    var JSONTabloAyarlar = Newtonsoft.Json.JsonConvert.SerializeObject(tablo);
    #endregion
}

<div class="row">
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-hdr">
                <h2></h2>
                <div class="panel-toolbar">
                    <button type="button" id="btnRaporUret" class="btn btn-primary btn-sm text-white spinnerButton" data-bekle-text="Rapor Hazırlanıyor...">
                        <span class="fal fa-download mr-2"></span>@CustomResource["Dugme.RaporUret"]
                    </button>
                    <div class="btn-group ml-2">
                        <button type="button" id="btnCiktiTur" class="btn btn-outline-secondary btn-sm dropdown-toggle waves-effect waves-themed" data-toggle="dropdown">
                            PDF
                        </button>
                        <div class="dropdown-menu" style="">
                            <a class="dropdown-item" href="javascript:CiktiTurAyarla('PDF');">PDF</a>
                            <a class="dropdown-item" href="javascript:CiktiTurAyarla('XLSX');">XLSX</a>
                            <a class="dropdown-item" href="javascript:CiktiTurAyarla('ODS');">ODS</a>
                        </div>
                    </div>
                </div>
            </div>
            <!--Datatables alanı-->
            <div class="panel-container">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <vc:data-table tablo-ayar="@JSONTabloAyarlar"></vc:data-table>
                    </div>
                </div>
            </div>
            <!-- Datatables alanı -->
        </div>
    </div>
</div>
<!--Veri giriş Modal formu-->
<div id="mdlTanim" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"></h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true"><i class="fal fa-times text-white"></i></span>
                </button>
            </div>
            <div class="modal-body">

                <ul class="nav nav-tabs nav-fill" role="tablist">
                    <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab-risk" role="tab">Risk Kaydı</a></li>
                    <li class="nav-item"><a class="nav-link " data-toggle="tab" href="#tab-degerlendirmesi" role="tab">Risklerin Değerlendirilmesi</a></li>
                    <li class="nav-item"><a class="nav-link " data-toggle="tab" href="#tab-yonetilmesi" role="tab">Risklerin Yönetilmesi</a></li>
                </ul>

                <form class="needs-validation" novalidate>

                    <div class="tab-content p-3">
                        <div class="tab-pane fade show active" id="tab-risk" role="tabpanel">
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskNo"]</label>
