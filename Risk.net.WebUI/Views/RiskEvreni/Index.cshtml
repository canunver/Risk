                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.BaslangicTarihi"]</label>
                                    <div class="divBaslangicTarihi"></div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.BitisTarihi"]</label>
