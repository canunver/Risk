                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.Durum"]</label>
                                    <div class="divDurum text-primary"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.Koordinatorluk"]</label>
                                    <div class="divKoordinatorluk"></div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.Birim"]</label>
                                    <div class="divBirim"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.Amac"]</label>
                                    <div class="divAmac"></div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.Hedef"]</label>
                                    <div class="divHedef"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label" for="ddlSurec">@CustomResource["RiskEvreni.Alan.Surec"]</label>
                                    <div class="divSurec"></div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="ddlAltSurec">@CustomResource["RiskEvreni.Alan.AltSurec"]</label>
                                    <div class="divAltSurec"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.RiskKategorileri"]</label>
                                    <div class="divRiskKategorisi"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.AnahtarRiskGostergesi"]</label>
                                    <div class="divAnahtarRiskGostergesi"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.RiskAdi"]</label>
                                    <div class="divRiskAdi"></div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.RiskTanimi"]</label>
                                    <div class="divRiskTanimi"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.Olay"]</label>
                                    <div class="divOlaylar"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.RiskGecerlilikTarihi"]</label>
                                    <div class="divRiskGecerlilikTarihi"></div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.RiskTuru"]</label>
                                    <div class="divRiskTuru"></div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="tab-degerlendirmesi" role="tabpanel">
                            <div id="tab-degerlendirmesi-ic">
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskNo"]</label>
                                        <div class="divRiskNo text-danger"></div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@CustomResource["RiskEvreni.Alan.Durum"]</label>
                                        <div class="divDurumRiskYonetimi text-primary"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskKategorisiAdi"]</label>
                                        <div class="divRiskKategorisi"></div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.AnahtarRiskGostergesiAdi"]</label>
                                        <a class='btn btn-primary btn-sm btn-icon text-white genelTooltip' title='@CustomResource["Baslik.AnahtarRiskGostergesi"]' onclick='AnahtarRiskGostergesiGoster();'><i class='fal fa-search'></i></a>
                                        <div class="divAnahtarRiskGostergesi"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.AnahtarRiskGostergesiSonDeger"]</label>
                                        <div>
                                            <span class="divAnahtarRiskGostergesiSonDeger"></span>
                                            <span class="divAnahtarRiskGostergesiUyari"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.Olasilik"]</label>
                                        <div class="divOlasilikKriter"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.Etki"]</label>
                                        <div class="divEtkiKriter"></div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.YapisalRiskPuani"]</label>
                                        <div class="divYapisalRiskPuani"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.YapisalRiskSeviyesi"]</label>
                                        <div class="divYapisalRiskSeviyesi" style="height: 25px; padding: 3px 0 0 5px; width: 120px;"></div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-12">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.KontrolTanimi"]</label>
                                        <table id="tblKontrolTanimi" class="table table-bordered table-hover table-striped table-sm w-100">
                                            <thead></thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.ArtikRiskPuani"]</label>
                                        <div class="divArtikRiskPuani"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.ArtikRiskSeviyesi"]</label>
                                        <div class="divArtikRiskSeviyesi" style="height: 25px; padding: 3px 0 0 5px; width: 120px;"></div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskeVerilecekCevap"]</label>
                                        <div class="divRiskeVerilecekCevap"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.Aciklama"]</label>
                                        <div class="divAciklamaRiskYonetimi"></div>
                                    </div>
                                </div>
                            </div>
                            <div id="tab-degerlendirmesi-kayitYok" style="display:none;" class="text-center text-primary"><img src="img/images/no-data-found.png" alt=""><br><h6>Gösterilecek kayıt yok</h6></div>
                        </div>
                        <div class="tab-pane fade" id="tab-yonetilmesi" role="tabpanel">
                            <div id="tab-yonetilmesi-ic">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.RiskNo"]</label>
