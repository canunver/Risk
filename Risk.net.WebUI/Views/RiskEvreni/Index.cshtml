                                <div class="col-md-3">
                                    <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.TamamlanmaYuzdesi"]</label>
                                    <div class="divTamamlanmaYuzdesi"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.AnahtarRiskGostergesiAdi"]</label>
                                    <div class="divAnahtarRiskGostergesi"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="ddlBirim">@CustomResource["RiskAzaltmaPlani.Alan.Sorumlu"]</label>
                                    <div class="divSorumluAzaltma"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskEvreni.Alan.Koordinatorluk"]</label>
                                    <div class="divKoordinatorluk"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.SorumluBirim"]</label>
                                    <div class="divSorumluBirim"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.BirimlerIsbirligi"]</label>
                                    <table id="tblDinamikKoorBirim" class="table table-bordered table-hover table-striped table-sm w-100">
                                        <thead></thead>
                                        <tbody></tbody>
                                    </table>
