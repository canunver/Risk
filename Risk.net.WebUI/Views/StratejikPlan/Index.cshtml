    //Dinamik tablodan sil düğmesine basıldığında
    function HedefSil(kontrol) {
        if (DTabloSadeceOkuma) return;

        var kod = $(kontrol).closest('tr')[0].id;
        var kontrolId = kod;

        var gSayisi = $(".hedef" + TemizHedefKodBilgisi(kod)).html();
        if (Number(gSayisi) > 0) {
            HataPenceresiGoster("Silmek istediğiniz Hedefe bağlı Anahtar Performans Göstergeleri bulunmaktadır. İlk önce Göstergeleri silin");
            return;
        }

        //Henüz kayıt edilmemiş olduğu için sunucuya gitme. Sadece yeni kayıtta gerçekleşir
