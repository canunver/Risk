    function HedefBirimKaydet() {
        var koordinatorlukKod = $("#ddlKoordinatorluk").val();
        if (!koordinatorlukKod) {
            $(".invalid-koordinatorluk").show();
            $(".invalid-div-koordinatorluk").css("border", "1px solid #fd3995");
            return;
        }

        var hedefKod = $("#hdnHedefGostergeKod").val();

        var IsbirligiBirimlerForm = [];
        $.makeArray($('#tblDinamikKoorBirim > tbody tr[id]').map(function () {

            var kod = this.id.replace("sttb_", "");
            var c = kod.split('_');

            IsbirligiBirimlerForm.push({
                KoordinatorlukKod: c[0],
                BirimKod: c[1]
            });
        }));

        var form = {
            Kod: hedefKod,
            KoordinatorlukKod: $("#ddlKoordinatorluk").val(),
            BirimKod: $("#ddlBirim").val(),
            IsbirligiBirimler: IsbirligiBirimlerForm,
        };

        $.ajax({
            type: "POST",
            dataType: "json",
            url: "/StratejikPlan/StratejikPlanHedefBirimKaydet",
            data: { form: form },
            success: function (result) {

                if (result.IslemSonuc) {
                    ShowToastr("success", "toast-top-right", result.Mesaj);

                    BirimEkraniKapat();
                }
            }
        });
    }

