        var satirBilgi = "<td width='20%'>" + adi + "</td><td width='10%'>" + etki + "</td><td width='20%' data-birim='" + birimBilgi[1] + "'>" + birimBilgi[0] + "</td><td width='20%'>" + aciklama + "</td><td width='20%'>" + revizyonNedeni + "</td><td width='10%'>" + revizyonTarihi + "</td>";

        var duzenle = "GostergeDuzenle"
        var sil = "GostergeSil";

        if (DTabloSadeceOkuma) {
            duzenle = "";
            sil = "";
            $(".dtabloVeriGirisGosterge").hide();
        }

        DinamikTabloSatirEkle("tblGosterge", kod, satirBilgi, duzenle, sil, "")
    }

