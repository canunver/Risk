    function TemizHedefKodBilgisi(kod) {
        return kod.replace("sttb_", "").replace("dtabloYeni_", "");
    }

    //ddlAramaYil
    function YilDoldur() {

        var aktifYil = new Date().getFullYear();;
        var yillar = [];
        for (var i = aktifYil; i >= 2020; i--) {
            var tarih = "01.01." + i;
            var nesne = { id: tarih, text: i.toString() };
            yillar.push(nesne);
        }

        Select2Yap("ddlAramaKayitTarihi", true, yillar);
    }

    function HedeflerSatirRender(row) {
        var hedefler = "";

        row.Hedefler.sort(function (a, b) { return (a.HedefNo > b.HedefNo) ? 1 : ((b.HedefNo > a.HedefNo) ? -1 : 0); });

        $.each(row.Hedefler, function (index) {
            var bilgi = row.Hedefler[index];
            if (bilgi.Durum != 99) {
                if (hedefler != "") hedefler += ",<br>";
                hedefler += "<b>" + bilgi.HedefNo + "</b> " + bilgi.Adi;
            }
        });

        return hedefler;
    }

