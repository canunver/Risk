            StratejikPlanKod: $("#hdnKod").val()
        };

        $.ajax({
            type: "POST",
            dataType: "json",
            url: "/StratejikPlan/StratejikPlanHedefKaydet",
            data: { form: form },
            success: function (result) {

                if (result.IslemSonuc) {
                    ShowToastr("success", "toast-top-right", result.Mesaj);

