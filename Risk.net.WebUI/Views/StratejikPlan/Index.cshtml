    //Dinamik tablo üstünde bulunan Ekle ve Güncelle düğmesine basıldığında
    function HedefKaydet() {

        if (DTabloSadeceOkuma) return;

        var kod = $("#hdnHedefKod").val();
        var adi = $("#txtHedefAdi").val();
        var StratejikPlanKod = $("#hdnKod").val();

        if ($.trim(adi) == "") return;
        var gSayisi = $(".hedef" + TemizHedefKodBilgisi(kod)).html();

