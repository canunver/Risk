@{
    ViewData["Title"] = CustomResource["StratejikPlan.SayfaBaslik"];
    ViewData["PageName"] = "StratejikPlan";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-window mr-2'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["StratejikPlan.SayfaAciklama"];
    ViewData["Category1"] = "";
    ViewData["Category1Url"] = "";
    ViewData["Yardim"] = ViewData["PageName"];

    #region DataTables yapılandırılması
    DataTablesYapi tablo = new DataTablesYapi();
    tablo.adi = "tblTanim";
    tablo.baslik = ViewData["Title"].ToString();
    tablo.listeUrl = "/StratejikPlan/TabloDoldur";
    tablo.silUrl = "/StratejikPlan/Sil";
    tablo.duzenleUrl = "/StratejikPlan/KayitGetir";
    tablo.anahtarAlani = "Kod";
    tablo.islemler.duzenlemeSonucMetodu = "Duzenle";
    tablo.islemler.genislik = "15%";
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.TarihceGoster"] + "' class='btn btn-info btn-sm btn-icon text-white genelTooltip' style='margin-right:5px;' onClick='TarihceGoster(!!DATA!!)'><i class='fal fa-history'></i></a>";
    tablo.siralamaKolonNo = 2;

    if (!ViewBag.KayitYetki)
    {
        tablo.islemler.duzenleme = false;
        tablo.islemler.goster = false;
    }

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "StratejikPlanDonem.BaslamaYil",
                adi = @CustomResource["StratejikPlan.Alan.Donem"],
                aramaTipi = "combo",
                aramaAlanAdi = "StratejikPlanDonemKod",
                aramaListeDoldurUrl = "/TanimStratejikPlanDonem/SelectListesiVer",
                render = "row.StratejikPlanDonemAdi"
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "KayitTarihi",
                adi = @CustomResource["StratejikPlan.Alan.Yil"],
                aramaTipi = "combo",
                aramaAlanAdi = "KayitTarihi",
                aramaListeDoldurMetodu = "YilDoldur()",
                render = "row.Yil",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "AmacNo",
                adi = @CustomResource["StratejikPlan.Alan.AmacNo"],
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Amac",
                adi = @CustomResource["StratejikPlan.Alan.Amac"],
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Kod",
                adi = @CustomResource["StratejikPlan.Alan.Hedefler"],
                siralama = false,
                aramadaGoster = false,
                render = "HedeflerSatirRender(row)"
            });
    //tablo.alanlar.Add(new DataTablesAlanlar
    //        {
    //            veriAlani = "Koordinatorluk.Adi",
    //            adi = @CustomResource["StratejikPlan.Alan.Koordinatorluk"],
    //            aramaTipi = "combo",
    //            aramaAlanAdi = "KoordinatorlukKod",
    //            aramaListeDoldurUrl = "/TanimKoordinatorluk/SelectListesiVer",
    //        });
    //tablo.alanlar.Add(new DataTablesAlanlar
    //        {
    //            veriAlani = "Birim.Adi",
    //            adi = @CustomResource["StratejikPlan.Alan.Birim"],
    //            aramadaGoster = false,
    //        });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Durum",
                adi = @CustomResource["Genel.Alan.Durum"],
                tipi = "int",
                genislik = "10%",
                render = "DurumAdiVer(data,'AKTIFPASIF')",
                aramaTipi = "combo",
                aramaListeDoldurMetodu = "DurumDoldur('ddlAramaDurum','AKTIFPASIF',false)",
            });

    var JSONTabloAyarlar = Newtonsoft.Json.JsonConvert.SerializeObject(tablo);
    #endregion

}

<div class="row">
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-hdr">
                <h2></h2>
                <div class="panel-toolbar">
                    <button id="btnYeniKayit" style="display:none;" class="btn btn-success text-white"><i class="fal fa-plus mr-1"></i>@CustomResource["Dugme.YeniKayit"]</button>
                </div>
            </div>
            <!--Datatables alanı-->
            <div class="panel-container">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <vc:data-table tablo-ayar="@JSONTabloAyarlar"></vc:data-table>
                    </div>
                </div>
            </div>
            <!-- Datatables alanı -->
        </div>
    </div>
</div>
<!--Veri giriş Modal formu-->
<div id="mdlTanim" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"></h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true"><i class="fal fa-times text-white"></i></span>
                </button>
            </div>
            <div class="modal-body">
                <form class="needs-validation" novalidate>
                    <input type="hidden" id="hdnKod" />
                    <input type="hidden" id="hdnHedefKod" />
                    <input type="hidden" id="hdnGostergeKod" />
                    <input type="hidden" id="hdnHedefGostergeKod" />
                    <input type="hidden" id="hdnBirimKod" />
                    <input type="hidden" id="hdnBirimlerKod" />

                    <div id="mdlTanimUyari"></div>

                    <div class="veriGiris">

                        <div class="form-group row">
                            <div class="col-md-6 divAmacNoAlani">
                                <label class="form-label">@CustomResource["StratejikPlan.Alan.AmacNo"]:</label>
                                <span class="divAmacNo text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ddlDonem">@CustomResource["StratejikPlan.Alan.Donem"]<span class="text-danger ml-1">*</span></label>
                                <select id="ddlDonem" required></select>
                                <div class="invalid-feedback">
                                    @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                                </div>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-12">
                                <label class="form-label" for="txtAmac">@CustomResource["StratejikPlan.Alan.Amac"]<span class="text-danger ml-1">*</span></label>
                                <input type="text" autocomplete="off" id="txtAmac" class="form-control form-control-sm" required />
                                <div class="invalid-feedback">
                                    @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                                </div>
                            </div>
                        </div>

                        <div class="form-group row divHedefler">
                            <div class="col-md-12">
                                <div class="p-3 rounded shadow-sm mb-g border border-faded">
                                    <label class="form-label">@CustomResource["StratejikPlan.Alan.Hedefler"]<span class="text-danger ml-1">*</span></label>
                                    <div class="input-group input-group-sm mb-2 dtabloVeriGiris">
                                        <input type="text" autocomplete="off" id="txtHedefAdi" class="form-control form-control-sm" placeholder="@CustomResource["StratejikPlan.Alan.HedefAdi"]" />
                                        <div class="input-group-append">
                                            <button class="btn btn-default waves-effect waves-themed" type="button" data-toggle="tooltip" title="@CustomResource["Dugme.Temizle"]" onclick="DTabloAlanTemizle();"><i class="fal fa-eraser"></i></button>
                                            <button class="btn btn-success" type="button" onclick="HedefKaydet();" id="btnHedefKaydet">@CustomResource["Dugme.Ekle"]</button>
                                        </div>
                                    </div>
                                    <div class="invalid-feedback invalid-hedef">
                                        @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                                    </div>
                                    <div class="invalid-feedback invalid-gosterge">
                                        @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                                    </div>

                                    <div id="divtblHedefVeriYok"></div>
                                    <table id="tblHedef" class="table table-bordered table-hover table-striped table-sm w-100" style="display:none">
                                        <thead></thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-row align-items-center flex-wrap flex-shrink-0">
                            <span class="spanDurum">@CustomResource["Genel.Alan.Durum"]: <span class="badge badge-primary p-2 text-white spnDurumAciklama"></span></span>
                            <div class="ml-auto">
                                <button type="button" id="btnKaydet" class="btn btn-primary text-white mr-1">@CustomResource["Dugme.Kaydet"]</button>
                                <button type="button" class="btn btn-secondary close-button" data-dismiss="modal">@CustomResource["Dugme.Kapat"]</button>
                            </div>
                        </div>
                    </div>
                    <div class="gostergeGiris" style="display:none">

                        <div class="row">
                            <div class="col-md-12">
                                <span class="h5 hedefAdi"></span>
                                <button type="button" class="btn btn-sm btn-info float-right waves-effect waves-themed" onclick="GostergeEkraniKapat(); return false;">@CustomResource["Dugme.GosterBolumKapat"]</button>
                                <div class="hedefKoordinatörlükAdi"></div>
                                <hr />
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-12">
                                <div class="p-3 rounded shadow-sm mb-g border border-faded">
                                    <label class="form-label">@CustomResource["StratejikPlan.Alan.Gostergeler"]<span class="text-danger ml-1">*</span></label>
                                    <i class="fas fa-question-circle cursor-pointer ml-1 genelTooltip" title="Belirlenen hedeflere ne ölçüde ulaşıldığının ortaya konulması için kullanılan metriklerdir."></i>

                                    <div class="input-group input-group-sm mb-2 dtabloVeriGirisGosterge">
                                        <div class="input-group input-group-sm mb-2">
                                            <input type="text" autocomplete="off" id="txtGostergeAdi" class="form-control form-control-sm" style="width:40%" placeholder="@CustomResource["StratejikPlan.Alan.GostergeAdi"] *" />
                                            <input type="text" autocomplete="off" id="txtHedefeEtkisi" class="form-control form-control-sm" style="width:10%" placeholder="@CustomResource["StratejikPlan.Alan.HedefeEtkisi"] *" />
                                        </div>
                                        <div class="input-group input-group-sm mb-2">
                                            <select id="ddlBirimGosterge" style="width:40%" data-placeholder="@CustomResource["StratejikPlan.Alan.GostergeBirim"]"></select>
                                        </div>
                                        <div class="input-group input-group-sm mb-2">
                                            <input type="text" autocomplete="off" id="txtGostergeAciklama" class="form-control form-control-sm" style="width:25%" placeholder="@CustomResource["StratejikPlan.Alan.GostergeAciklama"]" />
                                            <input type="text" autocomplete="off" id="txtRevizyonNedeni" class="form-control form-control-sm" style="width:20%" placeholder="@CustomResource["StratejikPlan.Alan.RevizyonNedeni"]" />
                                            <input type="text" autocomplete="off" id="txtRevizyonTarihi" class="form-control form-control-sm tarihAlani" style="width:10%" placeholder="@CustomResource["StratejikPlan.Alan.RevizyonTarihi"]" />
                                            <div class="input-group-append">
                                                <button class="btn btn-default waves-effect waves-themed" type="button" data-toggle="tooltip" title="@CustomResource["Dugme.Temizle"]" onclick="DTabloAlanTemizleGosterge();"><i class="fal fa-eraser"></i></button>
                                                <button class="btn btn-success waves-effect waves-themed" type="button" onclick="GostergeKaydet();" id="btnGostergeKaydet">@CustomResource["Dugme.Ekle"]</button>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="divtblGostergeVeriYok"></div>
                                    <table id="tblGosterge" class="table table-bordered table-hover table-striped table-sm w-100" style="display:none">
                                        <thead>
                                        <td>Gösterge Adı</td>
                                        <td>Etki</td>
                                        <td>Birim/Ünite</td>
                                        <td>Açıklama</td>
                                        <td>Revizyon Nedeni</td>
                                        <td>Revizyon Tarihi</td>
                                        <td></td>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="birimGiris" style="display:none">

                        <div class="row">
                            <div class="col-md-12">
                                <span class="h5 hedefAdi"></span>
                                <button type="button" class="btn btn-sm btn-info float-right waves-effect waves-themed" onclick="BirimEkraniKapat(); return false;">@CustomResource["Dugme.BirimBolumKapat"]</button>
                                <hr />
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-12">
                                <div class="p-3 rounded shadow-sm mb-g border border-faded">
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <button class="btn btn-success float-right" type="button" onclick="HedefBirimKaydet();" id="btnHedefBirimKaydet">@CustomResource["Dugme.Kaydet"]</button>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-6">
                                            <label class="form-label" for="ddlKoordinatorluk">@CustomResource["StratejikPlan.Alan.Koordinatorluk"]<span class="text-danger ml-1">*</span></label>
                                            <div class="invalid-div-koordinatorluk">
                                                <select id="ddlKoordinatorluk"></select>
                                            </div>
                                            <div class="invalid-feedback invalid-koordinatorluk">
                                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label" for="ddlBirim">@CustomResource["StratejikPlan.Alan.Birim"]</label>
                                            <select id="ddlBirim"></select>
                                        </div>
                                    </div>

                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label">@CustomResource["StratejikPlan.Alan.BirimlerIsbirligi"]</label>
                                            <div class="p-3 rounded shadow-sm mb-g border border-faded">
                                                <div class="input-group input-group-sm mb-2 dtabloVeriGiris">
                                                    <div class="w-75 d-flex" style="white-space:nowrap;">
                                                        <select id="ddlDinamikKoordinatorluk"></select>
                                                        <select id="ddlDinamikBirim"></select>
                                                    </div>
                                                    <div class="input-group-append">
                                                        <button class="btn btn-default" type="button" data-toggle="tooltip" title="@CustomResource["Dugme.Temizle"]" onclick="DTabloAlanTemizleIsbirligi();"><i class="fal fa-eraser"></i></button>
                                                        <button class="btn btn-success" type="button" onclick="DinamikKoorBirimKaydet();">@CustomResource["Dugme.Ekle"]</button>
                                                    </div>
                                                </div>

                                                <div id="divtblDinamikKoorBirimVeriYok"></div>
                                                <table id="tblDinamikKoorBirim" class="table table-bordered table-hover table-striped table-sm w-100" style="display:none">
                                                    <thead></thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var DTabloSadeceOkuma = false;
    var isBirligiKoordinatorlukler = [];
    var gostergeler = [];
    var kayitYetki = @(ViewBag.KayitYetki.ToString().ToLower());

    $(document).ready(function () {

        if (kayitYetki) {

            $("#btnYeniKayit").show();
        }

        Select2Yap("ddlBirim", true, null);
        Select2Yap("ddlDinamikBirim", true, null);
        Select2Yap("ddlBirimGosterge", true, null);

        //Dönem alanını doldurur
        $.ajax({
            url: "/TanimStratejikPlanDonem/SelectListesiVer",
            type: "POST",
            success: function (result) {

                Select2Yap("ddlDonem", true, result);
            }
        });

        //Koordinatörlük alanını doldur
        $.ajax({
            url: "/TanimKoordinatorluk/SelectListesiVer",
            type: "POST",
            success: function (result) {

                Select2Yap("ddlKoordinatorluk", true, result);
                result.push({ "id": "-101", "text": "Tüm Merkez Koordinatörlükleri" });
                result.push({ "id": "-100", "text": "Tüm İl Koordinatörlükleri" });
                Select2Yap("ddlDinamikKoordinatorluk", true, result);
            }
        });

        $('#ddlKoordinatorluk').bind('change', function () {
            var koordinatorlukKod = $(this).val();
            Select2Yap("ddlBirim", true, null);
            Select2Yap("ddlBirimler", true, null);
            if (koordinatorlukKod == null) return;

            $.ajax({
                url: "/TanimBirim/SelectListesiVer",
                data: { koordinatorlukKod: koordinatorlukKod },
                type: "POST",
                success: function (result) {

                    if (result.length > 0) {

                        Select2Yap("ddlBirim", true, result);
                        Select2Yap("ddlBirimler", true, result);

                        $("#ddlBirim").val($("#hdnBirimKod").val()).trigger('change');
                        $('#ddlBirim').prop('required', true);
                        $("#ddlBirim").attr("placeholder", "@Html.Raw(@CustomResource["Lutfen.Seciniz"])");

                        var birimler = $("#hdnBirimlerKod").val();
                        if (birimler != "") {
                            $("#ddlBirimler").val(birimler.split(',')).trigger('change');
                        }
                    }
                    else {

                        $('#ddlBirim').prop('required', false);
                        $("#ddlBirim").attr("placeholder", "Bu koordinatörlüğün birimi bulunmamaktadır");
                    }
                }
            });
        });

        $('#ddlDinamikKoordinatorluk').bind('change', function () {
            var koordinatorlukKod = $(this).val();

            $.ajax({
                url: "/TanimBirim/SelectListesiVer",
                data: { koordinatorlukKod: koordinatorlukKod },
                type: "POST",
                success: function (result) {

                    if (result.length > 0) {

                        Select2Yap("ddlDinamikBirim", true, result);
                    }
                }
            });
        });

        $("#btnKaydet").click(function () {

            //Validation
            $("#mdlTanimUyari").html("");
            $("#txtHedefAdi").css("border-color", "#E5E5E5");
            $("#txtHedefAdi").css("background-image", "url()");

            var formKontrol = ValidateForm();

            var amacKod = $("#hdnKod").val();

            if (amacKod) {
                //Validationda boş iken uyarı vermesi için yukarı taşındı
                //Hedeflerin tablodan alınması
                var altForm = [];
                var tabloDolu = false;
                $.makeArray($('#tblHedef > tbody tr[id]').map(function () {
                    //sadece kayıt edilmemiş olanlar gönderilecek. Bu işlem Yeni süreç kaydında dolacaktır
                    var kod = this.id.replace("sttb_", "");
                    if (kod.indexOf("dtabloYeni_") > -1) {
                        var hedefKod = kod;
                        var gostergelerJSON = gostergeler[TemizHedefKodBilgisi(hedefKod)];
                        if (!gostergelerJSON) gostergelerJSON = "[]";
                        var gostergeObject = JSON.parse(gostergelerJSON);
                        if (!gostergeObject)
                            gostergeObject = [];

                        var hedefAdi = $(this).find("td:eq(0)").clone().children().remove().end().text();

                        var aForm = { Kod: hedefKod, Adi: hedefAdi, Gostergeler: gostergeObject };
                        altForm.push(aForm);
                        tabloDolu = true;
                    }
                    else if (kod.length > 0)
                        tabloDolu = true;
                }));

                var gostergeUyari = "";
                var satir = 1;
                $.makeArray($('#tblHedef > tbody tr[id]').map(function () {

                    var kod = this.id.replace("sttb_", "");

                    var gSayisi = $(".hedef" + TemizHedefKodBilgisi(kod)).html();
                    if (Number(gSayisi) == 0) {
                        gostergeUyari += satir + ". satırda bulunan hedef için Anahtar Performans Göstergesi tanımlanmamıştır<br>";
                    }

                    satir++;
                }));

                if (gostergeUyari != "") {
                    $(".invalid-gosterge").html(gostergeUyari);
                    $(".invalid-gosterge").show();
                    return;
                }
                else
                    $(".invalid-gosterge").hide();

                if (!tabloDolu) {
                    $("#txtHedefAdi").css("border-color", "#fd3995");
                    $(".invalid-hedef").show();
                    formKontrol = false;
                }
                else
                    $(".invalid-hedef").hide();
            }

            if (!formKontrol) return;

            var form = {
                Kod: $("#hdnKod").val(),
                Amac: $("#txtAmac").val(),
                StratejikPlanDonemKod: $("#ddlDonem").val(),
                Hedefler: altForm,
            };

            $.ajax({
                url: "/StratejikPlan/Kaydet",
                data: JSON.stringify(form),
                contentType: "application/json; charset=utf-8",
                type: "POST",
                dataType: "json",
                success: function (result) {

                    if (result.IslemSonuc) {
                        ShowToastr("success", "toast-top-right", result.Mesaj);
                        Temizle();
                        TabloVeriYenile();//Datatables viewcontrolünde

                        $.ajax({
                            url: "/StratejikPlan/KayitGetir",
                            data: { kod: result.AnahtarAlan },
                            type: "POST",
                            success: function (result) {

                                if (result.IslemSonuc) {

                                    Duzenle(result);
                                    $(".divHedefler").show();
                                }
                                else {

                                    HataPenceresiGoster(result.Mesaj);

                                }
                            }
                        });


                        //jModalHide("mdlTanim");
                    }
                    else {

                        HataYazisiGoster("mdlTanimUyari", result.Mesaj);
                    }
                }
            });

        });

        $("#btnYeniKayit").click(function () {
            Temizle();

            jModalShow("mdlTanim", "@CustomResource["Baslik.YeniKayit"]");
        });
    });

    function GostergeBirimYukle(koordinatorlukKod) {

        Select2Yap("ddlBirimGosterge", true, null);

        if (koordinatorlukKod) {
            $.ajax({
                url: "/TanimBirim/SelectListesiVer",
                data: { koordinatorlukKod: koordinatorlukKod },
                type: "POST",
                success: function (result) {

                    if (result.length > 0) {

                        Select2Yap("ddlBirimGosterge", true, result);
                    }
                }
            });
        }
    }

    function Duzenle(result) {
        Temizle(result.Nesne);
        $('#btnKaydet').text('@Html.Raw(@CustomResource["Dugme.Guncelle"])');
        jModalShow("mdlTanim", "@CustomResource["Baslik.Guncelle"]");
    }

    function Temizle(deger) {
        ClearValidation();
        $(".divHedefler").hide();

        $(".invalid-hedef").hide();
        $(".invalid-gosterge").hide();
        $("#txtHedefAdi").css("border-color", "#E5E5E5");
        GostergeEkraniKapat();

        $("#tblDinamikKoorBirim > tbody").empty();
        DinamikTabloVeriYok("tblDinamikKoorBirim")

        $("#tblHedef > tbody").empty();
        DinamikTabloVeriYok("tblHedef")

        DTabloAlanTemizle();
        $(".dtabloVeriGiris").show();

        if (deger?.Durum == 10) {
            //$("#btnKaydet").hide();
            DTabloSadeceOkuma = true;
        }
        else {
            //$("#btnKaydet").show();
            DTabloSadeceOkuma = false;
        }

        $('#btnKaydet').text('@Html.Raw(@CustomResource["Dugme.Kaydet"])');

        $("#hdnKod").val(deger?.Kod);

        if (deger == undefined)
            $(".divAmacNoAlani").hide();
        else
            $(".divAmacNoAlani").show();

        $(".divAmacNo").html(deger?.AmacNo);

        $("#ddlKoordinatorluk").val(deger?.KoordinatorlukKod).trigger('change');
        $("#hdnBirimKod").val(deger?.BirimKod);
        $("#txtAmac").val(deger?.Amac);
        $("#ddlDonem").val(deger?.StratejikPlanDonemKod).trigger('change');

        if (deger?.Hedefler.length) {
            $(".divHedefler").show();
        }

        $.each(deger?.Hedefler, function (index) {
            var bilgi = deger.Hedefler[index]

            var hedefAdi = "<span class='fw-700 mr-2'>" + bilgi.HedefNo + "</span>" + bilgi.Adi
            DTabloSatirEkle(bilgi.Kod, hedefAdi)
            $(".hedef" + TemizHedefKodBilgisi(bilgi.Kod)).html(deger.Hedefler[index].Gostergeler.length);
        });

        $(".spnDurumAciklama").html(DurumAdiVer(deger?.Durum, 'AKTIFPASIF'));

        if (deger?.Kod == null) {
            $("#ddlKoordinatorluk").val("@ViewBag.KoordinatorlukKodu").trigger('change');
            $("#hdnBirimKod").val(@ViewBag.BirimKodu);
        }

        $("#mdlTanimUyari").html("");
    }

    function Onayla(kod) {
