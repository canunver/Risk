<script type="text/javascript">

    var dosyaDuzenlemeYetkisi = true;

    $(document).ready(function () {

        TanimGenelComboDoldur("ddlBulguGorusu", "BULGUCEVAPBULGUGORUSU");
        TanimGenelComboDoldur("ddlOneriGorusu", "BULGUCEVAPONERIGORUSU");
        TanimGenelComboDoldur("ddlOnemDuzeyiGorusu", "BULGUCEVAPONEMGORUSU");

        $(".btnKaydet").click(function () {

            //Validation
            var formKontrol = ValidateForm();
            if (!formKontrol) return;

            Kaydet()

        });

        $(".btnDosya").click(function () {
            var kod = $("#hdnKod").val();
            DosyaKontrolGoster("", kod, false, 999, true, !dosyaDuzenlemeYetkisi);
        });

        $('#ddlBulguGorusu').bind('change', function () {
            IcDenetimCevapEkranDuzenle();
        });
        $('#ddlOneriGorusu').bind('change', function () {
            IcDenetimCevapEkranDuzenle();
        });
        $('#ddlOnemDuzeyiGorusu').bind('change', function () {
            IcDenetimCevapEkranDuzenle();
        });

        if (@ViewBag.Onay == 1) {

            $(".btnOnayla").click(function () {
                Onayla($("#hdnKod").val());
            });
        }
        else {
            $(".btnOnayaGonder").click(function () {
                OnayaGonder($("#hdnKod").val());
            });
        }

    });

    function Kaydet() {
        var kaynak = $("#hdnKaynak").val();

        var sorumlusu = "";
        var eylem = "";
        var aciklama = "";
        var tamamlamaTarihi = "";

        if (kaynak == "1") {
            tamamlamaTarihi = $("#txtTamamlamaTarihi").val();
            sorumlusu = $("#txtSorumluKisi").val();
            eylem = $("#txtEylem").val();
            aciklama = $("#txtAciklama").val();
            sonDurum = $(".lblSonDurumIc").val();
        }
        else {
            tamamlamaTarihi = $("#txtTamamlamaTarihiDis").val();
            sorumlusu = $("#txtSorumluKisiDis").val();
            eylem = $("#txtEylemDis").val();
            aciklama = $("#txtAciklamaDis").val();
            sonDurum = $(".lblSonDurumDis").val();
        }

        var form = {
            Kod: $("#hdnKod").val(),
            CevapTarihi: TarihDegeriDDMMYYYY(moment()),
            TamamlamaTarihi: tamamlamaTarihi,
            BulguGorusuKod: $("#ddlBulguGorusu").val(),
            OneriGorusuKod: $("#ddlOneriGorusu").val(),
            OnemDuzeyiGorusuKod: $("#ddlOnemDuzeyiGorusu").val(),
            NedenBulguKatilmiyor: $("#txtBulguGorusNeden").val(),
            NedenOneriKatilmiyor: $("#txtOneriGorusNeden").val(),
            NedenOnemKatilmiyor: $("#txtOnemGorusNeden").val(),
            SonDurum: sonDurum,
            Aciklama: aciklama,
            Eylem: eylem,
            Sorumlusu: sorumlusu,
        };

        $.ajax({
            url: "/BulguYonetimiCevap/Kaydet",
            data: { form: form },
            type: "POST",
            success: function (result) {

                if (result.IslemSonuc) {
                    ShowToastr("success", "toast-top-right", result.Mesaj);

                    var eskiBaglantiKod = $("#hdnTmpBagliKod").val();
                    DinamikDosyaBaglantiKodGuncelle(eskiBaglantiKod, result.AnahtarAlan);

                    Temizle();
                    TabloVeriYenile();//Datatables viewcontrolünde
                    jModalHide("mdlTanimIc");
                    jModalHide("mdlTanimDis");
                }
                else {

                    HataYazisiGoster("mdlTanimUyari", result.Mesaj);
                }
            }
        });

    }

    function Duzenle(result) {
        Temizle(result.Nesne);
        if (result.Nesne.BulguYonetimi.Denetim.Kaynak == 1) {
            jModalShow("mdlTanimIc", "@CustomResource["Baslik.Guncelle"]");
        }
        else {
            jModalShow("mdlTanimDis", "@CustomResource["Baslik.Guncelle"]");
        }
    }

    function Temizle(deger) {
        ClearValidation();

        $('.btnKaydet').text('@Html.Raw(@CustomResource["Dugme.Kaydet"])');

        $("#hdnKod").val(deger?.Kod);

        $("#hdnKaynak").val(deger?.BulguYonetimi?.Denetim?.Kaynak);

        if (@ViewBag.Onay == 1) {
            $(".btnOnayla").show();
            $('.btnKaydet').hide();
        }
        else {
            if (deger?.Durum == 1)
                $(".btnOnayaGonder").show();
            else
                $(".btnOnayaGonder").hide();
        }

        if (deger?.Tur == 1) {
            $(".divCevapTur1Alanlar").show();
            $(".divCevapTur2Alanlar").hide();
        }
        else {
            $(".divCevapTur2Alanlar").show();
            $(".divCevapTur1Alanlar").hide();
        }

        if (deger?.Durum > 1) {
            dosyaDuzenlemeYetkisi = false;
            $(".btnKaydet").hide();
        }
        else {
            dosyaDuzenlemeYetkisi = true;
            $(".btnKaydet").show();
        }

        if (deger?.BulguYonetimi?.Denetim?.Kaynak == 1) {

            $("#ddlBulguGorusu").val(deger?.BulguGorusuKod).trigger('change');
            $("#ddlOneriGorusu").val(deger?.OneriGorusuKod).trigger('change');
            $("#ddlOnemDuzeyiGorusu").val(deger?.OnemDuzeyiGorusuKod).trigger('change');
            $("#txtAciklama").val(deger?.Aciklama);
            $("#txtEylem").val(deger?.Eylem).trigger('change');
            $("#txtTamamlamaTarihi").datepicker("update", TarihDegeriDDMMYYYY(deger?.TamamlamaTarihi));
            $("#txtSorumluKisi").val(deger?.Sorumlusu);

            $("#txtBulguGorusNeden").val(deger?.NedenBulguKatilmiyor).trigger('change');
            $("#txtOneriGorusNeden").val(deger?.NedenOneriKatilmiyor).trigger('change');
            $("#txtOnemGorusNeden").val(deger?.NedenOnemKatilmiyor).trigger('change');
            $(".lblSonDurumIc").val(deger?.SonDurum).trigger('change');

            $(".lblBulguTanimi").html(deger?.BulguYonetimi?.BulguTanimi);
        }
        else {
            $("#txtAciklamaDis").val(deger?.Aciklama).trigger('change');
            $("#txtEylemDis").val(deger?.Eylem).trigger('change');
            $("#txtTamamlamaTarihiDis").datepicker("update", TarihDegeriDDMMYYYY(deger?.TamamlamaTarihi));
            $("#txtSorumluKisiDis").val(deger?.Sorumlusu);
            $(".lblSonDurumDis").val(deger?.SonDurum).trigger('change');

            $(".lblBulguTanimiDis").html(deger?.BulguYonetimi?.BulguTanimi);
        }

        $(".lblDenetimAdi").html(deger?.BulguYonetimi?.Denetim?.DenetimAdi);
        $(".lblDenetimKurum").html(deger?.BulguYonetimi?.Denetim?.DenetimYapanKurum?.Adi);
        $(".lblDenetimYil").html(deger?.BulguYonetimi?.Denetim?.Yil);
        $(".lblBulguNo").html(deger?.BulguYonetimi?.BulguNo);
        $(".lblOnemDuzeyi").html(deger?.BulguYonetimi?.OnemDuzeyi?.Adi);
        $(".lblBulguDurum").html(DurumAdiVer(deger?.BulguYonetimi?.Durum, "BULGUYONETIMI", ""));
        $(".lblBulguAciklama").html(deger?.BulguYonetimi?.BulguAciklama);
        $(".lblNedenler").html(deger?.BulguYonetimi?.Nedenler);
        $(".lblKriterler").html(deger?.BulguYonetimi?.Kriterler);
        $(".lblRiskler").html(deger?.BulguYonetimi?.Riskler);
        $(".lblOneriler").html(deger?.BulguYonetimi?.Oneriler);
        $(".lblSonCevapTarihi").html(TarihDegeriDDMMYYYY(deger?.BulguYonetimi.SonCevapTarihi));

        var birimler = "";
        $.each(deger?.BulguYonetimi?.Birimler, function (a, b) {
            var koordinatorluk = b.Koordinatorluk?.Adi;
            var birim = b.Birim?.Adi;

            if (birimler != "") birimler += "<span style='color:#000'><b>,</b></span> ";
            birimler += koordinatorluk;
            if (birim && birim != "undefined")
                birimler += "-" + birim;
            birimler = birimler.replaceAll("undefined", "");

            $(".lblKoordinatorlukBirim").html(birimler);
        });

        DosyaDugmesineSayiOkuYaz(deger?.Kod, ".btnDosya");

        $("#mdlTanimUyari").html("");
    }

    function DurumVer(data) {

        var durumAdi = "";
        if (data == "1") durumAdi = "Yeni";
        if (data == "10") durumAdi = "Cevaplandı";
        if (data == "3") durumAdi = "Onaya Gönderildi";
        if (data == "99") renk = "İptal Edildi";
        return durumAdi;
    }

    function KaynakAdiVer(data) {

        var kaynakAdi = "";
        if (data == "1") kaynakAdi = "İç Denetim";
        if (data == "2") kaynakAdi = "Dış Denetim";
        return kaynakAdi;
    }

    function IcDenetimCevapEkranDuzenle() {
        var bulguGorusCevap = $("#ddlBulguGorusu option:selected").text();
        var oneriGorusCevap = $("#ddlOneriGorusu option:selected").text();
        var oneriOnemCevap = $("#ddlOnemDuzeyiGorusu option:selected").text();

        var kontrolStr = "Katılmıyoruz";
        bulguGorusCevap = bulguGorusCevap.indexOf(kontrolStr) > -1;
        oneriGorusCevap = oneriGorusCevap.indexOf(kontrolStr) > -1;
        oneriOnemCevap = oneriOnemCevap.indexOf(kontrolStr) > -1;

        if (bulguGorusCevap) {
            $(".divBulguGorusNeden").removeClass("control-hide");
            $(".divBulguGorusNeden").show();
        }
        else $(".divBulguGorusNeden").hide();

        if (oneriGorusCevap) {
            $(".divBulguGorusNeden").removeClass("control-hide");
            $(".divOneriGorusNeden").show();
        }
        else $(".divOneriGorusNeden").hide();

        if (oneriOnemCevap) {
            $(".divBulguGorusNeden").removeClass("control-hide");
            $(".divOnemGorusNeden").show();
        }
        else $(".divOnemGorusNeden").hide();

        if (!bulguGorusCevap) {
            $("#txtEylem").attr('required', true);
        }
        else
            $("#txtEylem").attr('required', false);

    }

    function CevapTarihiRender(row) {
        var ctarih = TarihDegeriDDMMYYYY(row.CevapTarihi);
        if (row.CevapTarihi > row.BulguYonetimi.SonCevapTarihi)
            ctarih += "<i class='fas fa-exclamation-circle ml-1 text-danger genelTooltip' title='Son Cevap Tarihinden sonra cevaplanmıştır'></i>";
        return ctarih;
    }

    function OnayaGonder(kod) {
        Swal.fire({
            title: '@CustomResource["Baslik.OnayaGonder"]',
            html: '@CustomResource["Onay.OnayaGonder"]',
            showCancelButton: true,
            confirmButtonText: '@CustomResource["Dugme.Evet"]',
            cancelButtonText: '@CustomResource["Dugme.Hayır"]'
        }).then(function (result) {
            if (result.value) {

                $.ajax({
                    url: "/BulguYonetimiCevap/OnayaGonder",
                    data: { kod: kod },
                    type: "POST",
                    success: function (result) {

                        if (result.IslemSonuc) {
                            ShowToastr("success", "toast-top-right", result.Mesaj);
                            Temizle();
                            TabloVeriYenile();
                            jModalHide("mdlTanimIc");
                            jModalHide("mdlTanimDis");
                        }
                        else {
                            HataPenceresiGoster(result.Mesaj);
                        }

                    }
                });
            }
        });
    }

    function Onayla(kod) {

        $("#hdnKod").val(kod);

        Swal.fire({
            title: '@CustomResource["Baslik.Onay"]',
            html: '@CustomResource["Onay.Onay"]',
            showCancelButton: true,
            confirmButtonText: '@CustomResource["Dugme.Evet"]',
            cancelButtonText: '@CustomResource["Dugme.Hayır"]'
        }).then(function (result) {
            if (result.value) {

                var form = {
                    Kod: $("#hdnKod").val(),
                };

                $.ajax({
                    url: "/BulguYonetimiCevap/Onayla",
                    data: { form: form },
                    type: "POST",
                    success: function (result) {

                        if (result.IslemSonuc) {

                            ShowToastr("success", "toast-top-right", result.Mesaj);

                            Temizle();
                            TabloVeriYenile();
                            jModalHide("mdlTanimIc");
                            jModalHide("mdlTanimDis");
                        }
                        else {

                            HataPenceresiGoster(result.Mesaj);

                        }
                    }
                });
            }
        });
    }

    function RaporHazirla(ciktiTur) {
        IslemYapiliyorBasla("btnYazdir");

        $.ajax({
            url: "/BulguYonetimiCevap/Yazdir",
            type: "POST",
            data: { Kod: $("#hdnKod").val(), ciktiTur: ciktiTur },
            xhrFields: {
                responseType: 'blob'
            },
            success: function (blob, status, xhr) {

                DosyaIndirJS(blob, status, xhr);

                IslemYapiliyorBitir("btnYazdir");
            },
            error: function (jqXHR, exception) {

                IslemYapiliyorBitir("btnYazdir");

                alert(exception);
            },
        });

    }


</script>
