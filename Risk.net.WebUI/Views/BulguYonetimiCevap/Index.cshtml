@{
    ViewData["Title"] = ViewBag.Onay == 1 ? ViewBag.Baslik : CustomResource["BulguYonetimiCevap.SayfaBaslik"];
    ViewData["PageName"] = "BulguYonetimiCevap";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-window mr-2'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["BulguYonetimiCevap.SayfaAciklama"];
    ViewData["Category1"] = "";
    ViewData["Category1Url"] = "";
    ViewData["Yardim"] = ViewData["PageName"];

    #region DataTables yapılandırılması
    DataTablesYapi tablo = new DataTablesYapi();
    tablo.adi = "tblTanim";
    tablo.baslik = ViewData["Title"].ToString();
    tablo.listeUrl = "/BulguYonetimiCevap/TabloDoldur?onay=" + ViewBag.Onay;
    tablo.silUrl = "/BulguYonetimiCevap/Sil";
    tablo.duzenleUrl = "/BulguYonetimiCevap/KayitGetir";
    tablo.anahtarAlani = "Kod";
    tablo.islemler.duzenlemeSonucMetodu = "Duzenle";
    tablo.islemler.genislik = "10%";
    tablo.islemler.silme = false;
    tablo.aramaAlaniGoster = false;
    if (ViewBag.Onay == 1)
        tablo.islemler.digerIslemler = "<a title='" + CustomResource["Dugme.Onayla"] + "' class='btn btn-success btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='Onayla(!!DATA!!)'><i class='fal fa-check'></i></a>";
    else
        tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.OnayaGonder"] + "' class='btn btn-warning btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='OnayaGonder(!!DATA!!)'><i class='fal fa-paper-plane'></i></a>";


    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "BulguYonetimi.Denetim.Kaynak",
                adi = @CustomResource["Denetim.Alan.Kaynak"],
                tipi = "int",
                genislik = "10%",
                render = "KaynakAdiVer(data)",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "BulguYonetimi.Denetim.DenetimNo",
                adi = @CustomResource["Denetim.Alan.DenetimNo"],
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "BulguYonetimi.Denetim.DenetimAdi",
                adi = @CustomResource["Denetim.Alan.DenetimAdi"],
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "BulguYonetimi.Denetim.DenetimYapanKurum.Adi",
                adi = @CustomResource["Denetim.Alan.DenetimYapanKurum"],
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "BulguYonetimi.BulguNo",
                adi = @CustomResource["BulguYonetimi.Alan.BulguNo"],
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "BulguYonetimi.BulguTanimi",
                adi = @CustomResource["BulguYonetimi.Alan.BulguTanimi"],
                siralama = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "BulguYonetimi.OnemDuzeyi.Adi",
                adi = @CustomResource["BulguYonetimi.Alan.OnemDuzeyi"],
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "CevapTarihi",
                adi = @CustomResource["BulguYonetimiCevap.Alan.CevapTarihi"],
                render = "CevapTarihiRender(row)",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "BulguYonetimi.SonCevapTarihi",
                adi = @CustomResource["BulguYonetimiCevap.Alan.SonCevapTarihi"],
                render = "TarihDegeriDDMMYYYY(data)",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Durum",
                adi = @CustomResource["Genel.Alan.Durum"],
                tipi = "int",
                genislik = "10%",
                render = "DurumVer(data)",
            });

    var JSONTabloAyarlar = Newtonsoft.Json.JsonConvert.SerializeObject(tablo);
    #endregion
}

<div class="row">
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-hdr">
                @if (@ViewBag.OnayMesaj == 1)
                {
                    <div class="text-danger m-2">
                        <span>Size onay için gönderilen cevapları <b>Bildirim Sisteminden</b> görebilirsiniz.</span>
                    </div>
                }
                <div class="panel-toolbar">
                </div>
            </div>
            <!--Datatables alanı-->
            <div class="panel-container">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <vc:data-table tablo-ayar="@JSONTabloAyarlar"></vc:data-table>
                    </div>
                </div>
            </div>
            <!-- Datatables alanı -->
        </div>
    </div>
</div>

<!--Veri giriş Modal formu-->
