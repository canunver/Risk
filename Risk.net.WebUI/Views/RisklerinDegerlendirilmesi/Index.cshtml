        function TabDegisti(tabAdi) {

            if (tabAdi == "#tab-yapisal") {
                $("#btnOnayaGonder").hide();
                $("#btnEtkiOlasilikMatrisiAc").show();
                $("#btnKontrolKriterMatrisiAc").hide();
            }
            else if (tabAdi == "#tab-artik") {
                $("#btnOnayaGonder").hide();
                $("#btnEtkiOlasilikMatrisiAc").hide();
                $("#btnKontrolKriterMatrisiAc").show();
            }
            else if (tabAdi == "#tab-cevap") {
                if (onayaGonder)
                    $("#btnOnayaGonder").show();
                $("#btnEtkiOlasilikMatrisiAc").hide();
                $("#btnKontrolKriterMatrisiAc").hide();
            }
            $("textarea").trigger('change');
        }

