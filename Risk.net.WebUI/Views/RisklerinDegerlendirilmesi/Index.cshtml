            DinamikTabloSatirEkle("tblDonemTanimiArg", form.Kod, satirBilgi, duzenle, sil, "");

            Select2Yap("select_" + form.Kod, true, periyotListesiArg);
            $("#select_" + form.Kod).val(form.Periyot).trigger('change');
        }

        function ArgKaydet() {
            $("#mdlTanimUyariArg").html("");
            //Validation
            var formKontrol = ValidateForm('needs-validation-arg');
            if (!formKontrol) return;

            var form = {
                Kod: $("#hdnKodArg").val(),
                RiskEvreniKod: $("#hdnRiskEvreniKod").val(),
                VeriDayanagi: $("#txtVeriDayanagiArg").val(),
                Adi: $("#txtAdiArg").val(),
                YesilDeger: SayiDegeriniOku("#txtYesilArg"),
                KirmiziDeger: SayiDegeriniOku("#txtKirmiziArg"),
                //YesilDegerSon: SayiDegeriniOku("#txtYesilSon"),
                //SariDeger: SayiDegeriniOku("#txtSari"),
                //SariDegerSon: SayiDegeriniOku("#txtSariSon"),
                //KirmiziDegerSon: SayiDegeriniOku("#txtKirmiziSon"),
                HedefDeger: SayiDegeriniOku("#txtHedefArg"),
                Donemler: DonemlerArg()
            };

            $.ajax({
                url: "/AnahtarRiskGostergesi/Kaydet",
                data: { form: form },
                type: "POST",
                success: function (result) {

                    if (result.IslemSonuc) {
                        ShowToastr("success", "toast-top-right", result.Mesaj);

                        $.ajax({
                            type: "POST",
                            dataType: "json",
                            url: "/RisklerinDegerlendirilmesi/KayitGetir",
                            data: {
                                kod: $("#hdnRiskEvreniKod").val(),
                            },
                            success: function (result2) {
                                if (result2.IslemSonuc) {
                                    var deger = result2.Nesne;
                                    $("#hdnAnahtarRiskGostergesiDurum").val(deger.AnahtarRiskGostergesi?.Durum);
                                    var anahtarRiskGostergesiDurum = AnahtarRiskGostergesiDurumVer(deger?.AnahtarRiskGostergesi?.Durum);
                                    var sonDonemDeger = deger?.AnahtarRiskGostergesi ? deger?.AnahtarRiskGostergesi?.SonDonemDeger : "";
                                    $(".divAnahtarRiskGostergesiSonDeger").html(anahtarRiskGostergesiDurum + " " + sonDonemDeger);
                                    $(".divAnahtarRiskGostergesiAdi").html(deger.AnahtarRiskGostergesi?.Adi);
                                }
                            }
                        });

                        ClearValidation('needs-validation-arg');
                        jModalHide("mdlTanimArg");
                    }
                    else {
                        HataYazisiGoster("mdlTanimUyariArg", result.Mesaj);
                    }
                }
            });
        }


    </script>
}


