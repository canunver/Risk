        function TabloVeriSilIc(kod) {
            Swal.fire({
                title: '@CustomResource["Baslik.Onay"]',
                html: '@CustomResource["Onay.Sil"]',
                showCancelButton: true,
                confirmButtonText: '@CustomResource["Dugme.Evet"]',
                cancelButtonText: '@CustomResource["Dugme.Hayır"]'
            }).then(function (result) {
                if (result.value) {

                    $.ajax({
                        url: "/RisklerinDegerlendirilmesi/KayitGetir",
                        type: "POST",
                        data: { kod: kod },
                        success: function (result) {

                            $.ajax({
                                url: "/RisklerinDegerlendirilmesi/Sil",
                                data: { form: result.Nesne.RiskYonetimi },
                                type: "POST",
                                success: function (result) {

                                    if (result.IslemSonuc) {
                                        ShowToastr("success", "toast-top-right", result.Mesaj);
                                        Temizle();
                                        TabloVeriYenile();
                                        jModalHide("mdlTanim");
                                    }
                                    else {
                                        HataPenceresiGoster(result.Mesaj);
                                    }

                                }
                            });
                        }
                    });

                }
            });
        }

