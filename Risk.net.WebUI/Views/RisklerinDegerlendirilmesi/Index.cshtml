@{
    ViewData["Title"] = CustomResource["RiskYonetimi.SayfaBaslik"];
    ViewData["PageName"] = "RisklerinDegerlendirilmesi";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-window mr-2'></i>" + ViewData["Title"];
    ViewData["PageDescription"] = CustomResource["RiskYonetimi.SayfaAciklama"];
    ViewData["Category1"] = "";
    ViewData["Category1Url"] = "";
    ViewData["Yardim"] = ViewData["PageName"];

    #region DataTables yapılandırılması
    DataTablesYapi tablo = new DataTablesYapi();
    tablo.adi = "tblTanim";
    tablo.baslik = ViewData["Title"].ToString();
    tablo.listeUrl = "/RisklerinDegerlendirilmesi/TabloDoldur";
    tablo.duzenleUrl = "/RisklerinDegerlendirilmesi/KayitGetir";
    tablo.silUrl = "/RisklerinDegerlendirilmesi/Sil";
    tablo.anahtarAlani = "Kod";
    tablo.anahtarAlani2 = "RiskYonetimi?.Kod";
    tablo.islemler.duzenlemeSonucMetodu = "Duzenle";
    tablo.islemler.genislik = "130px";
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.Degerlendir"] + "' class='btn btn-primary btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='TabloVeriDuzenle(!!DATA!!)'><i class='fal fa-pencil'></i></a>";
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.OnayaGonder"] + "' class='btn btn-success btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='OnayaGonder(!!DATA2!!)'><i class='fal fa-paper-plane'></i></a>";
    tablo.islemler.digerIslemler += "<a title='" + CustomResource["Dugme.TarihceGoster"] + "' class='btn btn-info btn-sm btn-icon waves-effect waves-themed text-white genelTooltip' style='margin-right:5px;' onClick='TarihceGoster(!!DATA2!!)'><i class='fal fa-history'></i></a>";
    tablo.islemler.duzenleme = false;
    tablo.islemler.silme = false;
    tablo.aramaAlaniGoster = true;
    tablo.siralamaKolonNo = 3;
    tablo.siralamaYonu = "desc";

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Koordinatorluk.Adi",
                adi = @CustomResource["RiskEvreni.Alan.Koordinatorluk"],
                aramaTipi = "combo",
                aramaAlanAdi = "KoordinatorlukKod",
                aramaListeDoldurUrl = "/TanimKoordinatorluk/SelectListesiVer",
                aramaAlaniSecimTetikle = "BirimDoldur('ddlAramaBirimKod','ddlAramaKoordinatorlukKod', false)",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Birim.Adi",
                adi = @CustomResource["RiskEvreni.Alan.Birim"],
                aramaTipi = "combo",
                aramaAlanAdi = "BirimKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaBirimKod', false, null, true)",
                aramaAlaniSecimTetikle = "SurecDoldur('ddlAramaSurecKod','ddlAramaKoordinatorlukKod','ddlAramaBirimKod', false);"
                                                                        + "AmacDoldur('ddlAramaAmacKod','ddlAramaKoordinatorlukKod', false);",
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Amac.Amac",
                adi = @CustomResource["RiskEvreni.Alan.Amac"],
                aramaTipi = "combo",
                aramaAlanAdi = "AmacKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaAmacKod', false, null, true)",
                aramaAlaniSecimTetikle = "HedefDoldur('ddlAramaHedefKod','ddlAramaAmacKod', false);",
                tablodaGoster = true,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Hedef.Adi",
                adi = @CustomResource["RiskEvreni.Alan.Hedef"],
                aramaTipi = "combo",
                aramaAlanAdi = "HedefKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaHedefKod', false, null, true)",
                tablodaGoster = true,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Surec.Adi",
                adi = @CustomResource["Surec.Alan.Adi"],
                aramaTipi = "combo",
                aramaAlanAdi = "SurecKod",
                aramaListeDoldurMetodu = "Select2Yap('ddlAramaSurecKod', false, null, true)"
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskNo",
                adi = @CustomResource["RiskEvreni.Alan.RiskNo"],
                render = "RiskNoRender(row.JenerikRisk,row.RiskYonetimi?.KontrolEdildi,data)",
                aramadaGoster = true,
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "Adi",
                adi = @CustomResource["RiskEvreni.Alan.RiskKategorisiAdi"],
                aramaTipi = "combo",
                aramaAlanAdi = "SorguRiskKategoriKod",
                aramaListeDoldurUrl = "/TanimRiskKategori/SelectListesiVer",
                tablodaGoster = false,
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskAdi",
                adi = @CustomResource["RiskEvreni.Alan.RiskAdi"],
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskTanimi",
                adi = @CustomResource["RiskEvreni.Alan.RiskTanimi"],
                aramadaGoster = true,
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskKategoriAdlari",
                adi = @CustomResource["RiskYonetimi.Alan.RiskKategorisiAdi"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "AnahtarRiskGostergesiAdi",
                adi = @CustomResource["RiskEvreni.Alan.AnahtarRiskGostergesi"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "IlIrtibatOfisleriAdlari",
                adi = @CustomResource["RiskEvreni.Alan.IlIrtibatOfisi"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskSahibi.AdiSoyadi",
                adi = @CustomResource["RiskEvreni.Alan.RiskSahibi"],
                siralama = true,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.MevcutKontroller",
                adi = @CustomResource["RiskYonetimi.Alan.MevcutKontroller"],
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.YapisalRiskPuaniRenk",
                adi = @CustomResource["RiskYonetimi.Alan.YapisalRiskPuani"],
                render = "YapisalRiskPuaniRenkVer(data)",
                siralama = false,
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.ArtikRiskPuaniRenk",
                adi = @CustomResource["RiskYonetimi.Alan.ArtikRiskPuani"],
                siralama = false,
                aramadaGoster = false
            });

    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.RiskeVerilecekCevap",
                adi = @CustomResource["RiskYonetimi.Alan.RiskeVerilecekCevap"],
                render = "RiskeVerilecekCevapAdiVer(data)",
                aramaTipi = "combo",
                aramadaGoster = false
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "",
                adi = @CustomResource["RiskEvreni.Alan.KontrolEdildi"],
                aramaTipi = "combo",
                aramaAlanAdi = "KontrolEdildi",
                aramaListeDoldurUrl = "/RiskEvreni/KontrolEdildiSelectListesiVer",
                tablodaGoster = false,
                aramadaGoster = true
            });
    tablo.alanlar.Add(new DataTablesAlanlar
            {
                veriAlani = "RiskYonetimi.Durum",
                adi = @CustomResource["Genel.Alan.Durum"],
                tipi = "int",
                genislik = "10%",
                render = "DurumAdiVer(data)",
                aramaTipi = "combo",
                aramaAlanAdi = "Durum",
                aramadaGoster = true
            });


    var JSONTabloAyarlar = Newtonsoft.Json.JsonConvert.SerializeObject(tablo);
    #endregion

}
@section HeadBlock {
    <link rel="stylesheet" media="screen, print" href="~/css/formplugins/ion-rangeslider/ion-rangeslider.css">
}

<div class="row">
    <div class="col-md-12">
        <div class="panel">
            @*<div class="panel-hdr">
            <h2></h2>
            <div class="panel-toolbar">
            <button id="btnYeniKayit" class="btn btn-success text-white"><i class="fal fa-plus mr-1"></i>@CustomResource["Dugme.YeniKayit"]</button>
            </div>
            </div>*@
            <!--Datatables alanı-->
            <div class="panel-container">
                <div class="panel-content">
                    <div class="frame-wrap">
                        <vc:data-table tablo-ayar="@JSONTabloAyarlar"></vc:data-table>
                    </div>
                </div>
            </div>
            <!-- Datatables alanı -->
        </div>
    </div>
</div>
<!--Veri giriş Modal formu-->
<div id="mdlTanim" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"></h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true"><i class="fal fa-times text-white"></i></span>
                </button>
            </div>
            <div class="modal-body">

                <ul class="nav nav-tabs nav-fill" role="tablist">
                    <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab-yapisal" role="tab">Yapısal Risk</a></li>
                    <li class="nav-item"><a class="nav-link disabled" data-toggle="tab" href="#tab-artik" role="tab">Artık Risk</a></li>
                    <li class="nav-item"><a class="nav-link disabled" data-toggle="tab" href="#tab-cevap" role="tab">Risklere Cevap Verilmesi</a></li>
                </ul>

                <form class="needs-validation" novalidate>
                    <input type="hidden" id="hdnKod" />
                    <input type="hidden" id="hdnRiskAzaltmaPlaniKod" />
                    <input type="hidden" id="hdnRiskEvreniKod" />
                    <input type="hidden" id="hdnKontrolTanimiKod" />
                    <input type="hidden" id="hdnAnahtarRiskGostergesiDurum" />

                    <div id="mdlTanimUyari"></div>
                    <div class="tab-content p-3">
                        <div class="tab-pane fade show active" id="tab-yapisal" role="tabpanel">
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskNo"]</label>
                                    <div class="divRiskNo text-danger"></div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskKategorisiAdi"]</label>
                                    <div class="divRiskKategorisi"></div>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskTanimi"]</label>
                                    <div class="divRiskTanimi"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.Amac"]</label>
                                    <div class="divAmac"></div>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskAdi"]</label>
                                    <div class="divRiskAdi"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.Hedef"]</label>
                                    <div class="divHedef"></div>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.AnahtarRiskGostergesiAdi"]</label>
                                    <a class='btn btn-primary btn-sm btn-icon text-white genelTooltip' title='@CustomResource["Baslik.AnahtarRiskGostergesi"]' onclick='ArgGoster();'><i class='fal fa-search'></i></a>
                                    <div class="divAnahtarRiskGostergesiAdi"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.Surec"]</label>
                                    <div class="divSurec"></div>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.AnahtarRiskGostergesiSonDeger"]</label>
                                    <div>
                                        <span class="divAnahtarRiskGostergesiSonDeger"></span>
                                        <span class="divAnahtarRiskGostergesiUyari"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div>
                                        <label class="form-label">@CustomResource["RiskEvreni.Alan.RiskSahibi"]</label>
                                        <div class="divRiskSahibi"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label" for="txtOlasilik">@CustomResource["RiskYonetimi.Alan.Olasilik"]<span class="text-danger ml-1">*</span></label>
                                    <input id="txtOlasilik" type="text" value="" class="d-none" tabindex="-1" readonly="">
                                    <div class="divOlasilikKriter"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="txtEtki">@CustomResource["RiskYonetimi.Alan.Etki"]<span class="text-danger ml-1">*</span></label>
                                    <input id="txtEtki" type="text" value="" class="d-none" tabindex="-1" readonly="">
                                    <button type="button" id="btnEtkiAciklamaGoster" data-toggle="popover" data-trigger="focus" data-placement="top" data-html="true" data-title="Etki Kriteri" data-template='<div class="popover bg-warning-500 border-warning" role="tooltip"><div class="arrow"></div><h3 class="popover-header bg-transparent"></h3><div class="popover-body"></div></div>' class='btn btn-warning btn-sm btn-icon text-white' style='float:right;'><i class='fal fa-question'></i></button>
                                    <div class="divEtkiKriter"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.YapisalRiskPuani"]</label>
                                    <div class="divYapisalRiskPuani"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.YapisalRiskSeviyesi"]</label>
                                    <div class="divYapisalRiskSeviyesi" style="height: 25px; padding: 3px 0 0 5px; width: 120px;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="tab-artik" role="tabpanel">
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskTanimi"]</label>
                                    <div class="divRiskTanimi"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskAdi"]</label>
                                    <div class="divRiskAdi"></div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <div class="p-3 rounded shadow-sm mb-g border border-faded">
                                        <label class="form-label">@CustomResource["RiskYonetimi.Alan.KontrolTanimi"]<span class="text-danger ml-1">*</span></label>
                                        <div class="custom-control custom-checkbox" style="float: right;">
                                            <input type="checkbox" class="custom-control-input" id="chkMevcutKontrolBulunmamaktadir" />
                                            <label class="custom-control-label" for="chkMevcutKontrolBulunmamaktadir">@CustomResource["RiskYonetimi.Alan.MevcutKontrolBulunmamaktadir"]</label>
                                        </div>
                                        <div class="input-group input-group-sm mb-2 dtabloVeriGiris" style="display:none;">
                                            <textarea id="txtKontrolTanimi" rows="1" class="form-control form-control-sm" placeholder="@CustomResource["RiskYonetimi.Alan.KontrolTanimi"]"></textarea>
                                            <div class="input-group-append">
                                                <button class="btn btn-default waves-effect waves-themed" type="button" data-toggle="tooltip" title="@CustomResource["Dugme.Temizle"]" onclick="DTabloAlanTemizle();"><i class="fal fa-eraser"></i></button>
                                                <button class="btn btn-success" type="button" onclick="KontrolTanimiKaydet();" id="btnKontrolTanimiKaydet">@CustomResource["Dugme.Ekle"]</button>
                                            </div>
                                        </div>

                                        <div id="divtblKontrolTanimiVeriYok"></div>
                                        <table id="tblKontrolTanimi" class="table table-bordered table-hover table-striped table-sm w-100" style="display:none">
                                            <thead></thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.ArtikRiskPuani"]</label>
                                    <div class="divArtikRiskPuani"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.ArtikRiskSeviyesi"]</label>
                                    <div class="divArtikRiskSeviyesi" style="height: 25px; padding: 3px 0 0 5px; width: 120px;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="tab-cevap" role="tabpanel">
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskTanimi"]</label>
                                    <div class="divRiskTanimi"></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="ddlRiskeVerilecekCevap">@CustomResource["RiskYonetimi.Alan.RiskeVerilecekCevap"]</label>
                                    <select id="ddlRiskeVerilecekCevap"></select>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label">@CustomResource["RiskYonetimi.Alan.RiskAdi"]</label>
                                            <div class="divRiskAdi"></div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label">@CustomResource["RiskYonetimi.Alan.YapisalRiskPuani"]</label>
                                            <div class="divYapisalRiskPuani"></div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label">@CustomResource["RiskYonetimi.Alan.YapisalRiskSeviyesi"]</label>
                                            <div class="divYapisalRiskSeviyesi" style="height: 25px; padding: 3px 0 0 5px; width: 120px;"></div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label">@CustomResource["RiskYonetimi.Alan.ArtikRiskPuani"]</label>
                                            <div class="divArtikRiskPuani"></div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label">@CustomResource["RiskYonetimi.Alan.ArtikRiskSeviyesi"]</label>
                                            <div class="divArtikRiskSeviyesi" style="height: 25px; padding: 3px 0 0 5px; width: 120px;"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label" for="txtAciklama">@CustomResource["RiskYonetimi.Alan.Aciklama"]</label>
                                            <textarea id="txtAciklama" rows="1" class="form-control form-control-sm"></textarea>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label">*@CustomResource["RiskYonetimi.Alan.Bilgilendirme"]</label>
                                            <div class="divBilgilendirme" style="padding: 5px; border: solid 1px #E5E5E5;">
                                                <div><span style="color:red;font-weight:600;">@CustomResource["RiskYonetimi.RiskeVerilecekCevap.TransferEt"]:</span> @CustomResource["RiskYonetimi.Bilgilendirme.TransferEt"]</div>
                                                <div><span style="color:red;font-weight:600;">@CustomResource["RiskYonetimi.RiskeVerilecekCevap.KabulEt"]:</span>  @CustomResource["RiskYonetimi.Bilgilendirme.KabulEt"]</div>
                                                <div><span style="color:red;font-weight:600;">@CustomResource["RiskYonetimi.RiskeVerilecekCevap.Reddet"]:</span> @CustomResource["RiskYonetimi.Bilgilendirme.Reddet"]</div>
                                                <div><span style="color:red;font-weight:600;">@CustomResource["RiskYonetimi.RiskeVerilecekCevap.Azalt"]:</span> @CustomResource["RiskYonetimi.Bilgilendirme.Azalt"]</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="pnlAciklama" style="display:none;" class="form-group row">
                                        <div class="col-md-12">
                                            <label class="form-label" for="txtTarihceAciklama"></label>
                                            <textarea id="txtTarihceAciklama" rows="1" class="form-control form-control-sm" disabled></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-row align-items-center flex-wrap flex-shrink-0">
                        <div id="pnlKontrolEdildi" class="ml-auto mb-4" style="display:none;">
                            <label class="form-label"></label>
                            <div class="custom-control custom-checkbox" style="float: right;">
                                <input type="checkbox" class="custom-control-input" id="chkKontrolEdildi" />
                                <label class="custom-control-label" style="width:90px;" for="chkKontrolEdildi">@CustomResource["RiskEvreni.Alan.KontrolEdildi"]</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-row align-items-center flex-wrap flex-shrink-0">
                        <div>
                            <button type="button" id="btnRiskSahibiDegistir" class="btn btn-danger text-white mr-1" style="display:none;">@CustomResource["Dugme.RiskSahibiDegistir"]</button>
                        </div>
                        <div class="ml-auto">
                            <button type="button" id="btnEtkiOlasilikMatrisiAc" class="btn btn-secondary text-white mr-1">@CustomResource["Dugme.EtkiOlasilikMatrisiAc"]</button>
                            <button type="button" id="btnKontrolKriterMatrisiAc" class="btn btn-secondary text-white mr-1">@CustomResource["Dugme.KontrolKriterMatrisiAc"]</button>
                            <button type="button" id="btnOnayaGonder" class="btn btn-success text-white mr-1" style="display:none;">@CustomResource["Dugme.OnayaGonder"]</button>
                            <button type="button" id="btnKaydet" class="btn btn-primary text-white mr-1">@CustomResource["Dugme.Kaydet"]</button>
