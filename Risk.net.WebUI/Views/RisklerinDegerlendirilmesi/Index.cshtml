        //Dinamik tablo üstünde bulunan Ekle ve Güncelle düğmesine basıldığında
        function KontrolTanimiKaydet() {

            if (DTabloSadeceOkuma) return;

            var kod = $("#hdnKontrolTanimiKod").val();
            var adi = $("#txtKontrolTanimi").val();

            var riskYonetimiKod = $("#hdnKod").val();

            if ($.trim(adi) == "") return;

            var knt = Kontroller();

            var form = {
                Kod: kod,
                Tanim: adi,
                RiskYonetimiKod: riskYonetimiKod,
                Etkinlik: 1,
                OnemDuzeyi: (knt.length == 0 ? 100 : 0),
            };

            if (form.Kod == "") form.Kod = "dtabloYeni_" + jQuery.guid++;
            DTabloSatirEkle(form);
            DTabloAlanTemizle();

            $("#mdlTanimUyari").html("");
