@section ScriptsBlock{
    <script src="~/js/formplugins/ion-rangeslider/ion-rangeslider.js"></script>
    <script type="text/javascript">
        var DTabloSadeceOkuma = false;
        var onayaGonder = false;
        var etkiKriteriAciklama = "";
        durumlarListe = @Html.Raw(ViewBag.DurumListesi);
        var riskeVerilecekCevapListe = @Html.Raw(ViewBag.RiskeVerilecekCevapListesi);
        //var artikRiskSeviyesiListe = @Html.Raw(ViewBag.ArtikRiskSeviyesiListesi);
        var etkiOlasilikMatrisi = @Html.Raw(ViewBag.EtkiOlasilikMatrisi);
        var aktifTabKontrol = false;
        var periyotListesiArg = @Html.Raw(ViewBag.PeriyotListesiArg);
        var riskSahibiDegistir = @Html.Raw(ViewBag.RiskSahibiDegistir);
        var riskKod = "@Html.Raw(ViewBag.RiskKod)";
        var riskSekretaryasi = @Html.Raw(ViewBag.RiskSekretaryasi);

        $(document).ready(function () {

            Select2Yap("ddlKontrolEdildi", true, null);
            Select2Yap("ddlAramaDurum", true, durumlarListe);
            Select2Yap("ddlRiskeVerilecekCevap", true, riskeVerilecekCevapListe);

            $("#txtOlasilik").ionRangeSlider({
                skin: "big",
                grid: false,
                min: 1,
                max: 5,
            });

            $("#txtEtki").ionRangeSlider({
                skin: "big",
                grid: false,
                min: 1,
                max: 5
            });

            $("#txtOlasilik").on("change", function () {
                var d = $(this);
                var deger = d.prop("value");
                var kriter = olasilikKriter[deger - 1];
                $(".divOlasilikKriter").html(kriter);
                YapisalRiskPuaniHesapla();
            });

            $("#txtEtki").on("change", function () {
                var d = $(this);
                var deger = d.prop("value");
                var kriter = etkiKriter[deger - 1];
                $(".divEtkiKriter").html(kriter);
                YapisalRiskPuaniHesapla();
                EtkiKriteriAciklamaDoldur();
            });

            $('a[data-toggle="tab"]').on('show.bs.tab', function (e) {
                var tabAdi = $(this).attr('href');
                TabDegisti(tabAdi);
            });

            $("#btnEtkiOlasilikMatrisiAc").click(function () {
                EtkiOlasilikMatrisiGoster();
            });

            $("#btnKontrolKriterMatrisiAc").click(function () {
                KontrolKriterMatrisiGoster();
            });

            $('#btnEtkiAciklamaGoster').on('click', function () {
                if ($('.popover').hasClass('in')) {
                    $(this).popover('hide');
                }
                else {
                    $(this).attr('data-content', etkiKriteriAciklama);
                    $(this).popover('show');
                }
            });



            $("#btnKaydet").click(function () {

                var kayit = false;

                if ($("#hdnKod").val() != "") {
                    $.ajax({
                        url: "/RisklerinDegerlendirilmesi/DegisiklikUyari",
                        type: "POST",
                        data: {
                            Kod: $("#hdnRiskEvreniKod").val(),
                            RiskYonetimi: { RiskeVerilecekCevap: $("#ddlRiskeVerilecekCevap").val() },
                        },
                        success: function (result) {
                            if (result.IslemSonuc) {
                                Kaydet();
                            }
                            else {
                                Swal.fire({
                                    title: '@CustomResource["Baslik.Onay"]',
                                    html: '@CustomResource["Onay.RisklerinDegerlendirilmesiDegisiklikUyarisi"]',
                                    showCancelButton: true,
                                    confirmButtonText: '@CustomResource["Dugme.Evet"]',
                                    cancelButtonText: '@CustomResource["Dugme.Hayır"]'
                                }).then(function (result) {
                                    if (result.value) {
                                        Kaydet();
                                    }
                                });
                            }
                        }
                    });
                }
                else
                    Kaydet();

            });

            $("#btnOnayaGonder").click(function () {
                OnayaGonder($("#hdnKod").val());
            });


            $("#btnKaydetArg").click(function () {
                ArgKaydet();
            });

            if (riskSahibiDegistir)
                $("#btnRiskSahibiDegistir").show();

            $("#btnRiskSahibiDegistir").click(function () {
                ClearValidation('needs-validation-riskSahibiDegistir');

                Select2Yap("ddlRiskSahibi", true, null);

                $.ajax({
                    url: "/TanimYetki/RiskSahibiListesiVer",
                    type: "POST",
                    data: { koordinatorlukKod: $("#hdnRiskSahibiKoordinatorlukKod").val(), birimKod: $("#hdnRiskSahibiBirimKod").val(), listeyeEklenecekPersonelkod: $("#hdnRiskSahibiKod").val() },
                    success: function (result) {
                        Select2Yap("ddlRiskSahibi", true, result);
                        $("#ddlRiskSahibi").val($("#hdnRiskSahibiKod").val()).trigger('change');

                        jModalShow("mdlRiskSahibiDegistir", "@CustomResource["Baslik.RiskSahibiDegistir"]");
                    }
                });

            });

            $("#btnRiskSahibiDegistirKaydet").click(function () {

                $("#mdlTanimUyari").html("");
                //Validation
                var formKontrol = ValidateForm('needs-validation-riskSahibiDegistir');
                if (!formKontrol) return;

                var form = {
                    Kod: $("#hdnRiskEvreniKod").val(),
                    RiskSahibiKod: $("#ddlRiskSahibi").val(),
                };

                $.ajax({
                    url: "/RiskKaydi/RiskSahibiDegistir",
                    data: { form: form },
                    type: "POST",
                    success: function (result) {

                        if (result.IslemSonuc) {
                            ShowToastr("success", "toast-top-right", result.Mesaj);

                            ClearValidation('needs-validation-riskSahibiDegistir');

                            //$("#hdnRiskSahibiKoordinatorlukKod").val('');
                            //$("#hdnRiskSahibiBirimKod").val('');
                            //$("#hdnRiskSahibiKod").val('');

                            jModalHide("mdlRiskSahibiDegistir");

                            TabloVeriDuzenle($("#hdnRiskEvreniKod").val());

                            //Temizle();
                            //TabloVeriYenile();
                            //jModalHide("mdlTanim");
                        }
                        else {
                            HataYazisiGoster("mdlTanimUyari", result.Mesaj);
                        }
                    }
                });

            });


            $('#ddlRiskeVerilecekCevap').bind('change', function () {
                var cevap = $("#ddlRiskeVerilecekCevap").val();
                if (cevap == "4") //Azalt
                {
                    $('#txtAciklama').prop('required', false);
                    $("#txtAciklama").attr("disabled", true);
                }
                else {
                    $('#txtAciklama').prop('required', true);
                    $("#txtAciklama").attr("disabled", false);
                }
            });

            $('#chkMevcutKontrolBulunmamaktadir').bind('change', function () {

                if ($(this).prop('checked')) {
                    $(".dtabloVeriGiris").hide();

                    $("#tblKontrolTanimi > tbody").empty();
                    DinamikTabloVeriYok("tblKontrolTanimi");
                    DTabloAlanTemizle();
                }
                else {
                    $(".dtabloVeriGiris").show();

                    //var satirBilgi = "<th width='55%'>@Html.Raw(@CustomResource["RiskYonetimi.Alan.KontrolTanimi"])</th><th width='25%'>@Html.Raw(@CustomResource["RiskYonetimi.Alan.KontrolEtkinligi"])</th><th width='15%'>@Html.Raw(@CustomResource["RiskYonetimi.Alan.KontrolOnemDuzeyi"]) (%) </th><th width='5%'></th>";
                    //DinamikTabloSatirEkle("tblKontrolTanimi", "0", satirBilgi, "", "", "");
                }

            });

            //if (riskSekretaryasi)
            $("#pnlKontrolEdildi").show();

            if (riskKod != "") {
                var pathname = window.location.pathname;
                window.history.pushState({ path: '' }, '', pathname);
                TabloVeriDuzenle(riskKod);
            }

        });

        function Kaydet() {
            var kontroller = Kontroller();

            //Validation
            $("#mdlTanimUyari").html("");
            var formKontrol = ValidateForm();
            if (!formKontrol) return;


            if ($('[href="#tab-artik"]').hasClass('active')) {
                if ($("#hdnKod").val() != "" && kontroller.length == 0 && !$('#chkMevcutKontrolBulunmamaktadir').prop("checked")) {
                    HataYazisiGoster("mdlTanimUyari", "Kontrol tanımına ait bilgi girişi bulunamadı!");
                    return;
                }
            }

            var form = {
                Kod: $("#hdnKod").val(),
                RiskAzaltmaPlani: { Kod: $("#hdnRiskAzaltmaPlaniKod").val() },
                RiskEvreniKod: $("#hdnRiskEvreniKod").val(),
                Olasilik: $("#txtOlasilik").val(),
                Etki: $("#txtEtki").val(),
                Kontroller: kontroller,
                RiskeVerilecekCevap: $("#ddlRiskeVerilecekCevap").val(),
                Aciklama: $("#txtAciklama").val(),
                KontrolEdildi: $("#chkKontrolEdildi").is(':checked') ? 1 : 0,
            };

            $.ajax({
                url: "/RisklerinDegerlendirilmesi/Kaydet",
                data: { form: form },
                type: "POST",
                success: function (result) {

                    if (result.IslemSonuc) {
                        ShowToastr("success", "toast-top-right", result.Mesaj);
                        //Temizle();
                        TabloVeriYenile();//Datatables viewcontrolünde
                        //jModalHide("mdlTanim");

                        $.ajax({
                            type: "POST",
                            dataType: "json",
                            url: "/RisklerinDegerlendirilmesi/KayitGetir",
                            data: {
                                kod: $("#hdnRiskEvreniKod").val(),
                            },
                            success: function (result2) {
                                if (result2.IslemSonuc) {
                                    aktifTabKontrol = true;
                                    Duzenle(result2);
                                }
                            }
                        });

                    }
                    else {
                        HataYazisiGoster("mdlTanimUyari", result.Mesaj);
                    }
                }
            });
        }

        function OnayaGonder(kod) {
            if (!(kod == null || kod == undefined)) {
                Swal.fire({
                    title: '@CustomResource["Baslik.OnayaGonder"]',
                    html: '@CustomResource["Onay.OnayaGonder"]',
                    showCancelButton: true,
                    confirmButtonText: '@CustomResource["Dugme.Evet"]',
                    cancelButtonText: '@CustomResource["Dugme.Hayır"]'
                }).then(function (result) {
                    if (result.value) {

                        $.ajax({
                            url: "/RisklerinDegerlendirilmesi/OnayaGonder",
                            data: { kod: kod },
                            type: "POST",
                            success: function (result) {

                                if (result.IslemSonuc) {
                                    ShowToastr("success", "toast-top-right", result.Mesaj);
                                    Temizle();
                                    TabloVeriYenile();
                                    jModalHide("mdlTanim");
                                }
                                else {
                                    HataPenceresiGoster(result.Mesaj);
                                }

                            }
                        });
                    }
                });
            }

        }

        function Kontroller() {
            //Kontrollerin tablodan alınması
            var kontroller = [];
            $.makeArray($('#tblKontrolTanimi > tbody tr[id]').map(function () {
                if ($(this).find("td:eq(0)").html() != null) {
                    //sadece kayıt edilmemiş olanlar gönderilecek. Bu işlem Yeni süreç kaydında dolacaktır
                    var kod = this.id.replace("sttb_", "");
                    //if (kod.indexOf("dtabloYeni_") > -1) {
                    var aForm = {
                        Kod: "",
                        RiskYonetimiKod: $("#hdnKod").val(),
                        Tanim: $(this).find("td:eq(0) textarea").val(),
                        Etkinlik: $(this).find("td:eq(1) input").val(),
                        OnemDuzeyi: $(this).find("td:eq(2) input").val(),
                    };
                    kontroller.push(aForm);
                    //}
                }
            }));
            return kontroller;
        }

        function EtkiKriteriAciklamaDoldur() {
            etkiKriteriAciklama = "";
            $.ajax({
                url: "/Konfigurasyon/EtkiKriteriAdiVer",
                data: { seviye: parseInt($("#txtEtki").val()), riskKategorisi: $(".divRiskKategorisi").html() },
                type: "POST",
                success: function (result) {
                    etkiKriteriAciklama = result;
                }
            });
        }

        function YapisalRiskPuaniHesapla() {
            var olasilik = parseFloat($("#txtOlasilik").val());
            var etki = parseFloat($("#txtEtki").val());
            var yapisalRiskPuani = olasilik * etki;
            $(".divYapisalRiskPuani").html(yapisalRiskPuani);

            YapisalRiskSeviyesiGetir(etki, olasilik);
        }

        function YapisalRiskSeviyesiGetir(etki, olasilik) {
            if (etki > 0 && olasilik > 0) {
                $.ajax({
                    url: "/Konfigurasyon/YapisalRiskSeviyesiVer",
                    data: { etki: etki, olasilik: olasilik },
                    type: "POST",
                    success: function (result) {
                        $(".divYapisalRiskSeviyesi").html(result?.seviyeAdi);
                        $(".divYapisalRiskSeviyesi").css('background-color', result?.renk);
                        $(".divYapisalRiskSeviyesi").css('color', '#ffffff');
                        $(".divYapisalRiskSeviyesi").css('border', 'solid 1px #000000');
                        AnahtarRiskGostergesineGoreAciklama(result?.seviyeNo);
                    }
                });
            }
            else {
                $(".divYapisalRiskSeviyesi").html('');
                $(".divYapisalRiskSeviyesi").css('background-color', '#ffffff');
                $(".divYapisalRiskSeviyesi").css('color', '#000000');
                $(".divYapisalRiskSeviyesi").css('border', 'none');
                AnahtarRiskGostergesineGoreAciklama(0);
            }
        }

        function ArtikRiskPuaniHesapla() {
            var etkinlikAgirligi = 0;
            $.each(Kontroller(), function (a, b) {
                var agirlik = 0;
                if (b.Etkinlik == 5)
                    agirlik = 0.2 * b.OnemDuzeyi / 100;
                else if (b.Etkinlik == 4)
                    agirlik = 0.4 * b.OnemDuzeyi / 100;
                else if (b.Etkinlik == 3)
                    agirlik = 0.6 * b.OnemDuzeyi / 100;
                else if (b.Etkinlik == 2)
                    agirlik = 0.8 * b.OnemDuzeyi / 100;
                else if (b.Etkinlik == 1)
                    agirlik = 1 * b.OnemDuzeyi / 100;

                etkinlikAgirligi += parseFloat(agirlik);
            });

            if (etkinlikAgirligi == 0)
                etkinlikAgirligi = 1;

            var olasilik = parseFloat($("#txtOlasilik").val());
            var etki = parseFloat($("#txtEtki").val());
            var yapisalRiskPuani = olasilik * etki;
            var artikRiskPuani = parseFloat(yapisalRiskPuani * etkinlikAgirligi).toFixed(2);
            $(".divArtikRiskPuani").html(artikRiskPuani);

            ArtikRiskSeviyesiGetir(artikRiskPuani);
        }

        function ArtikRiskSeviyesiGetir(artikRiskPuani) {
            if (artikRiskPuani > 0) {
                $.ajax({
                    url: "/Konfigurasyon/ArtikRiskSeviyesiVer",
                    data: { artikRiskPuani: artikRiskPuani },
                    type: "POST",
                    success: function (result) {
                        $(".divArtikRiskSeviyesi").html(result?.seviyeAdi);
                        $(".divArtikRiskSeviyesi").css('background-color', result?.renk);
