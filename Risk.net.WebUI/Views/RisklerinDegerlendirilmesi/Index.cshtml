        function AnahtarRiskGostergesiDurumVer(data) {

            var renk = "";
            if (data == "KIRMIZI") renk = "#dc3545";
            if (data == "SARI") renk = "#ffc107";
            if (data == "YEŞİL") renk = "#28a745";

            if (renk != "")
                return "<span class='text-center genelTooltip' data-toggle='tooltip' style='color:" + renk + "' title='" + data + "'><i class='fas fa-circle'></i></span>";
            else
                return "";
        }

        function AnahtarRiskGostergesineGoreAciklama(seviyeNo) {
            var anahtarGostergeDurum = $("#hdnAnahtarRiskGostergesiDurum").val();
            var aciklama = "";
            if (anahtarGostergeDurum == "YEŞİL" && (seviyeNo == "4" || seviyeNo == "5")) {
                aciklama = "Anahtar Risk Göstergesi durumu YEŞİL değer aralığında olan bir risk için Yapısal Risk Seviyesini Yüksek/Çok Yüksek seçtiniz. Kontrol ediniz.";
            }
            else if (anahtarGostergeDurum == "SARI" && seviyeNo == "1") {
                aciklama = "Anahtar Risk Göstergesi durumu SARI değer aralığında olan bir risk için Yapısal Risk Seviyesini Çok Düşük seçtiniz. Kontrol ediniz.";
            }
            else if (anahtarGostergeDurum == "KIRMIZI" && (seviyeNo == "1" || seviyeNo == "2")) {
                aciklama = "Anahtar Risk Göstergesi durumu KIRMIZI değer aralığında olan bir risk için Yapısal Risk Seviyesini Çok Düşük/Düşük seçtiniz. Kontrol ediniz.";
            }

            if (aciklama != "")
                aciklama = "<i class='fal fa-lightbulb-exclamation text-warning ml-2'></i>&nbsp;" + aciklama;

            $(".divAnahtarRiskGostergesiUyari").html(aciklama);
        }

