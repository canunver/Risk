                        $.each(deger?.RiskYonetimi?.RiskAzaltmaPlani?.IsbirligiBirimler, function (a, b) { IsbirligiBirimlerForm.push(b.BirimKod); });
                        $("#ddlBirimlerIsbirligi").val(IsbirligiBirimlerForm).trigger('change');
                    }
                }
            });
        }

        $.ajax({
                url: "/RisklerinYonetilmesi/SelectListesiVerAzaltmaPlani",
            data: { kod: $('#hdnKod').val() },
            type: "POST",
            success: function (result) {
                Select2YapTemplate("ddlIliskiliAzaltmaPlani", true, result, true, IskiliAzaltmaPlaniTemplate2);

                var IliskiliPlanlarForm = [];
                $.each(deger?.RiskYonetimi?.RiskAzaltmaPlani?.IliskiliPlanlar, function (a, b) { IliskiliPlanlarForm.push(b.IliskiKod); });
                $("#ddlIliskiliAzaltmaPlani").val(IliskiliPlanlarForm).trigger('change');
