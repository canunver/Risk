                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.AzaltmaPlaniNo"]</label>
                            <div class="divAzaltmaPlaniNo"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.ArtikRiskSeviyesi"]</label>
                            <div class="divArtikRiskSeviyesi"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.ArtikRiskPuani"]</label>
                            <div class="divArtikRiskPuani"></div>
                        </div>
                    </div>
                    <div class="form-group row">
                          <div class="col-md-12">
                            <label class="form-label" for="txtRiskAdi">@CustomResource["RiskAzaltmaPlani.Alan.RiskAdi"]</label>
                            <select id="ddlRiskAdi" multiple></select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
