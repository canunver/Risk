                            <input type="text" autocomplete="off" id="txtBaslangicTarihi" class="form-control form-control-sm tarihAlani" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="txtBitisTarihi">@CustomResource["RiskAzaltmaPlani.Alan.BitisTarihi"]<span class="text-danger ml-1">*</span></label>
                            <input type="text" autocomplete="off" id="txtBitisTarihi" class="form-control form-control-sm tarihAlani" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.AnahtarRiskGostergesiAdi"]</label>
                            <div class="divAnahtarRiskGostergesiAdi"></div>
                        </div>
                    </div>

                    <div class="form-group row">
                        @* <div class="col-md-6">
                        <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.Koordinatorluk"]<span class="text-danger ml-1">*</span></label>
                        <div class="divKoordinatorluk"></div>
                        </div>
                        <div class="col-md-6">
                        <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.SorumluBirim"]<span class="text-danger ml-1">*</span></label>
                        <div class="divSorumluBirim"></div>
                        </div>*@
                        <div class="col-md-6">
                            <label class="form-label" for="ddlKoordinatorluk">@CustomResource["RiskAzaltmaPlani.Alan.SorumluKoordinatorluk"]<span class="text-danger ml-1">*</span></label>
                            <select id="ddlKoordinatorluk" required></select>
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ddlBirim">@CustomResource["RiskAzaltmaPlani.Alan.SorumluBirim"]<span class="text-danger ml-1">*</span></label>
                            <select id="ddlSorumluBirim" required></select>
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
                            </div>
                        </div>
                    </div>

                   @* <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.BirimlerIsbirligi"]</label>
                            <div class="divBirimlerIsbirligi"></div>
                        </div>
                    </div>*@
                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label">@CustomResource["RiskAzaltmaPlani.Alan.BirimlerIsbirligi"]</label>
                            <div class="p-3 rounded shadow-sm mb-g border border-faded isbirligiEkleSil">
                                <div class="input-group input-group-sm mb-2 dtabloVeriGiris">
                                    <div class="w-75 d-flex" style="white-space:nowrap;">
