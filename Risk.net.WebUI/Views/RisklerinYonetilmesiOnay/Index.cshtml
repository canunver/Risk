            KoordinatorlukKod: deger?.RiskAzaltmaPlaniSorumluKoordinatorluk?.Kod,
            BirimKod: deger?.RiskAzaltmaPlaniSorumluBirim?.Kod,
        };

        $.ajax({
                url: "/RiskKaydi/SelectListesiVerRiskAdi",
            data: { form: form },
            type: "POST",
            success: function (result) {
                    Select2Yap("ddlRiskAdi", true, result);

                var risklerForm = [];
                $.each(deger?.RiskYonetimi?.RiskAzaltmaPlani?.Riskler, function (a, b) { risklerForm.push(b.RiskEvreniKod); });
                if (risklerForm.length == 0) { risklerForm.push(deger.Kod); }
                $("#ddlRiskAdi").val(risklerForm).trigger('change');
            }
