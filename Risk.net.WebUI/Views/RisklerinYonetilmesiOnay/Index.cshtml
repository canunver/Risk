                    <div class="form-group row">
                        <div class="col-md-12">
                            <label class="form-label" for="txtErtelemeNot">@CustomResource["RiskAzaltmaPlani.Alan.ErtelemeNot"]<span class="text-danger ml-1">*</span></label>
                            <textarea id="txtErtelemeNot" rows="1" class="form-control form-control-sm"></textarea>
