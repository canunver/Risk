        $(".divArtikRiskSeviyesi").html(ArtikRiskSeviyesiAdiVer(deger?.RiskYonetimi?.ArtikRiskSeviyesi));
        $(".divArtikRiskPuani").html(deger?.RiskYonetimi?.ArtikRiskPuaniRenk);
