                                    <textarea id="txtDonemNotlari" rows="1" class="form-control form-control-sm" placeholder="@CustomResource["RiskAzaltmaPlani.Alan.DonemlerNotu"]"></textarea>
                                    <div class="input-group-append">
                                        <button class="btn btn-default waves-effect waves-themed" type="button" data-toggle="tooltip" title="@CustomResource["Dugme.Temizle"]" onclick="DTabloAlanTemizle();"><i class="fal fa-eraser"></i></button>
                                        <button class="btn btn-success" type="button" onclick="DonemNotlariKaydet();" id="btnDonemNotlariKaydet">@CustomResource["Dugme.Ekle"]</button>
                                    </div>
                                </div>

                                <div id="divtblDonemNotlariVeriYok"></div>
                                <table id="tblDonemNotlari" class="table table-bordered table-hover table-striped table-sm w-100" style="display:none">
                                    <thead></thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                         <div class="col-md-12">
                            <label class="form-label" for="txtAzaltmaPlaniNotlar">@CustomResource["RiskAzaltmaPlani.Alan.AzaltmaPlaniNotlar"]</label>
                            <textarea id="txtAzaltmaPlaniNotlar" rows="1" class="form-control form-control-sm"></textarea>
                        </div>
                    </div>

