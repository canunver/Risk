    function Onayla(kod) {
        Swal.fire({
            title: '@CustomResource["Baslik.Onay"]',
            html: '@CustomResource["Onay.Onay"]',
            showCancelButton: true,
            confirmButtonText: '@CustomResource["Dugme.Evet"]',
            cancelButtonText: '@CustomResource["Dugme.Hayır"]'
        }).then(function (result) {
            if (result.value) {

                var riskler = $("#ddlRiskAdi").val();
                var risklerForm = [];
                $.each(riskler, function (a, b) { risklerForm.push({ RiskEvreniKod: b }); });

                var notlarForm = DonemNotlariKontroller();

                var IliskiliPlanlar = $("#ddlIliskiliAzaltmaPlani").val();
                var IliskiliPlanlarForm = [];
                $.each(IliskiliPlanlar, function (a, b) { IliskiliPlanlarForm.push({ IliskiKod: b }); });

                var IsbirligiBirimlerForm = [];
                $.makeArray($('#tblDinamikKoorBirim > tbody tr[id]').map(function () {

                    var kod = this.id.replace("sttb_", "");
                    var c = kod.split('_');

                    IsbirligiBirimlerForm.push({
                        KoordinatorlukKod: c[0],
                        BirimKod: c[1]
                    });
                }));

                var form = {
                    Kod: kod,
                    RiskYonetimiKod: $("#hdnRiskYonetimiKod").val(),
                    RiskEvreniKod: $("#hdnRiskEvreniKod").val(),
                    MevcutDurum: $("#ddlMevcutDurum").val(),
                    BaslangicTarihi: $("#txtBaslangicTarihi").val(),
                    BitisTarihi: $("#txtBitisTarihi").val(),
                    TamamlamaYuzdesi: $("#txtTamamlanmaYuzdesi").val(),
                    AzaltmaPlani: $("#txtAzaltmaPlani").val(),
                    SorumluKoordinatorlukKod: $("#ddlKoordinatorluk").val(),
                    SorumluBirimKod: $("#ddlSorumluBirim").val(),
                    AzaltmaPlaniSorumlusuKod: $("#ddlSorumlu").val(),
                    AzaltmaPlaniNotlar: $("#txtAzaltmaPlaniNotlar").val(),
                    ErtelemeBaslangicTarihi: $("#txtErtelemeBaslangicTarihi").val(),
                    ErtelemeBitisTarihi: $("#txtErtelemeBitisTarihi").val(),
                    ErtelemeNot: $("#txtErtelemeNot").val(),
                    Riskler: risklerForm,
                    Notlar: notlarForm,
                    IliskiliPlanlar: IliskiliPlanlarForm,
                    IsbirligiBirimler: IsbirligiBirimlerForm
                };

                $.ajax({
                        url: "/RisklerinYonetilmesiOnay/Onayla",
                    data: { form: form },
                    type: "POST",
                    success: function (result) {

                        if (result.IslemSonuc) {

                            ShowToastr("success", "toast-top-right", result.Mesaj);

                            Temizle();
                            TabloVeriYenile();
                            jModalHide("mdlTanim");
                        }
                        else {

                            HataPenceresiGoster(result.Mesaj);

                        }
                    }
                });
            }
        });
    }

    function OnayaGonder(kod) {
        if (!(kod == null || kod == undefined)) {
                Swal.fire({
                    title: '@CustomResource["Baslik.OnayaGonder"]',
                    html: '@CustomResource["Onay.OnayaGonder"]',
                    showCancelButton: true,
                    confirmButtonText: '@CustomResource["Dugme.Evet"]',
                    cancelButtonText: '@CustomResource["Dugme.Hayır"]'
                }).then(function (result) {
                    if (result.value) {

                        $.ajax({
                            url: "/RisklerinYonetilmesi/OnayaGonder",
                            data: { kod: kod },
                            type: "POST",
                            success: function (result) {

                                if (result.IslemSonuc) {
                                    ShowToastr("success", "toast-top-right", result.Mesaj);
                                    Temizle();
                                    TabloVeriYenile();
                                    jModalHide("mdlTanim");
                                }
                                else {
                                    HataPenceresiGoster(result.Mesaj);
                                }

                            }
                        });
                    }
                });
            }

    }

    function Duzenle(result) {
        Temizle(result.Nesne);
        jModalShow("mdlTanim", "@CustomResource["Baslik.Guncelle"]");
    }

    function Temizle(deger) {
        ClearValidation();

        $("#tblKontrolTanimi > tbody").empty();
        DinamikTabloVeriYok("tblKontrolTanimi")

        $("#tblDonemNotlari > tbody").empty();
        DinamikTabloVeriYok("tblDonemNotlari")
        DTabloAlanTemizle();

        //$('#btnKaydet').text('@Html.Raw(@CustomResource["Dugme.Kaydet"])');

        onayaGonder = false;
        $('#btnOnayaGonder').hide();

        if (deger?.RiskYonetimi?.RiskAzaltmaPlani?.Kod != undefined) {
            //$('#btnKaydet').text('@Html.Raw(@CustomResource["Dugme.Guncelle"])');
            $('#btnOnayla').show();

            $('#btnOnayaGonder').show();
            if (deger?.RiskYonetimi?.RiskAzaltmaPlani?.Durum > 2) {
                $("#btnKaydet").hide();
                $("#btnOnayaGonder").hide();
                onayaGonder = false;
            }
            else if (deger?.RiskYonetimi?.RiskAzaltmaPlani?.Durum > 0 && deger?.RiskYonetimi?.RiskAzaltmaPlani?.Durum < 3) {
                $("#btnOnayaGonder").show();
                $("#btnKaydet").show();
                onayaGonder = true;
            }
