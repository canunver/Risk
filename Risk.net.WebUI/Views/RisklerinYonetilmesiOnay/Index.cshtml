                            <textarea id="txtAzaltmaPlani" rows="1" class="form-control form-control-sm" autocomplete="off" required></textarea>
                            <div class="invalid-feedback">
                                @CustomResource["Kontrol.Kaydet.AlanBosOlamaz"]
